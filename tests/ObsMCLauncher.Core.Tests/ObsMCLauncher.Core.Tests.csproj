<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ObsMCLauncher.Core\ObsMCLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 动态背景测试素材（探针 .temp/probe/assets 的少量样本）：
         tiny.gif 合法 8 帧 GIF、anim_dirty.webp 40 帧动画 WebP、
         static.png 静态 PNG、anim_dirty.png 合法 APNG（验证 D7 拒收路径）、
         over_frames.gif 4×4/2001 帧（帧数闸门）、over_edge.png 8193×1（长边闸门） -->
    <Content Include="WallpaperAssets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

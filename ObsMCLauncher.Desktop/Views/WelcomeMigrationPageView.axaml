<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="480"
             x:Class="ObsMCLauncher.Desktop.Views.WelcomeMigrationPageView"
             x:DataType="vm:WelcomeMigrationPageViewModel">

    <UserControl.Styles>
        <!-- 紧凑复选框：小图标 + 标题 + 描述（仿 ClassIsland） -->
        <Style Selector="CheckBox">
            <Setter Property="Padding" Value="4 6" />
        </Style>
        <Style Selector="CheckBox TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <!-- 仿 ClassIsland 数据迁移向导：Carousel 分步（选来源 → 配置导入 → 导入中 → 完成） -->
    <Grid Width="600" VerticalAlignment="Stretch" HorizontalAlignment="Center">
        <Carousel SelectedIndex="{Binding PageIndex}"
                  VerticalAlignment="Stretch">

            <Carousel.PageTransition>
                <CompositePageTransition>
                    <PageSlide Duration="0:0:0.3" Orientation="Horizontal" />
                    <CrossFade Duration="0:0:0.3" />
                </CompositePageTransition>
            </Carousel.PageTransition>

            <!-- 页 0：选择导入来源 -->
            <Border VerticalAlignment="Center">
                <StackPanel Spacing="2">
                    <TextBlock Text="数据迁移" HorizontalAlignment="Center"
                               Margin="0 0 0 4"
                               FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="向 ObsMCLauncher 导入数据。"
                               HorizontalAlignment="Center"
                               Margin="0 0 0 12" />
                    <ui:SettingsExpander Header="Plain Craft Launcher 2"
                                         Description="导入应用设置、各版本游戏设置与外置登录服务器数据的位置见 PCL 目录"
                                          IsClickEnabled="True"
                                          MinHeight="64"
                                          Click="SourcePcl_OnClick">
                        <ui:SettingsExpander.IconSource>
                            <ui:BitmapIconSource UriSource="avares://ObsMCLauncher.Desktop/Assets/LauncherIcons/PCL2.png"
                                                 ShowAsMonochrome="False" />
                        </ui:SettingsExpander.IconSource>
                    </ui:SettingsExpander>
                    <ui:SettingsExpander Header="Hello Minecraft! Launcher (3.16+)"
                                         Description="新版配置格式（config 目录下的 JSON 文件）"
                                          IsClickEnabled="True"
                                          MinHeight="64"
                                          Click="SourceHmclNew_OnClick">
                        <ui:SettingsExpander.IconSource>
                            <ui:BitmapIconSource UriSource="avares://ObsMCLauncher.Desktop/Assets/LauncherIcons/HMCL.png"
                                                 ShowAsMonochrome="False" />
                        </ui:SettingsExpander.IconSource>
                    </ui:SettingsExpander>
                    <ui:SettingsExpander Header="Hello Minecraft! Launcher (≤3.15.x)"
                                         Description="旧版 hmcl.json 配置格式"
                                          IsClickEnabled="True"
                                          MinHeight="64"
                                          Click="SourceHmclLegacy_OnClick">
                        <ui:SettingsExpander.IconSource>
                            <ui:BitmapIconSource UriSource="avares://ObsMCLauncher.Desktop/Assets/LauncherIcons/HMCL.png"
                                                 ShowAsMonochrome="False" />
                        </ui:SettingsExpander.IconSource>
                    </ui:SettingsExpander>
                </StackPanel>
            </Border>

            <!-- 页 1：配置导入 -->
            <Border VerticalAlignment="Center">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="选择要导入的数据" HorizontalAlignment="Center"
                               Margin="0 0 0 4"
                               FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SourceDescription}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0 0 0 12" />

                    <!-- 来源主程序路径 -->
                    <StackPanel Spacing="6" Margin="0 0 0 8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="启动器主程序" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="浏览" Click="BrowseSourceButton_OnClick" />
                        </Grid>
                        <TextBox Text="{Binding SourceExecutablePath}"
                                 Watermark="{Binding ExecutableHint}"
                                 FontSize="12" />
                        <TextBlock Text="{Binding SourceHint}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <CheckBox IsChecked="{Binding ImportGameSettings}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm4-3c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"
                                 Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                 Width="18" Height="18" Stretch="Uniform"
                                 VerticalAlignment="Center" />
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="游戏设置" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="包括各实例的内存、Java 路径、JVM 参数与版本隔离设置。"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding ImportAppSettings}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.2 15.42l-.97 2.05-2.29-.75c-.6.38-1.27.68-1.98.87l-.12 2.42h-2.7l-.12-2.42c-.71-.19-1.38-.49-1.98-.87l-2.29.75-.97-2.05 1.88-1.61c-.12-.43-.2-.88-.2-1.36s.08-.93.2-1.36L4.7 13.05l.97-2.05 2.29.75c.6-.38 1.27-.68 1.98-.87l.12-2.42h2.7l.12 2.42c.71.19 1.38.49 1.98.87l2.29-.75.97 2.05-1.88 1.61c.12.43.2.88.2 1.36s-.08.93-.2 1.36l1.88 1.61z"
                                 Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                 Width="18" Height="18" Stretch="Uniform"
                                 VerticalAlignment="Center" />
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="应用设置" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="包括游戏文件夹、Java、内存、下载与更新等应用首选项。"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </CheckBox>

                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <Button Command="{Binding BackCommand}"
                                ToolTip.Tip="上一步"
                                Width="48" Height="48"
                                CornerRadius="24"
                                Margin="0 12 0 0">
                            <ui:SymbolIcon Symbol="ChevronLeft" FontSize="18" />
                        </Button>
                        <Button Command="{Binding StartImportCommand}"
                                ToolTip.Tip="开始导入"
                                Width="48" Height="48"
                                CornerRadius="24"
                                Classes="accent"
                                Margin="0 12 0 0">
                            <ui:SymbolIcon Symbol="ChevronRight" FontSize="18" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 页 2：导入中 -->
            <Border VerticalAlignment="Center">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="正在导入" HorizontalAlignment="Center"
                               Margin="0 0 0 4"
                               FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="请坐和放宽，导入很快就能完成。"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0 0 0 4" />
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="48" Height="48"
                                     Margin="0 8 0 0"
                                     HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 页 3：导入完成 -->
            <Border VerticalAlignment="Center">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ResultSummary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ImportError}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="480"
                               FontSize="12"
                               Foreground="{DynamicResource WarningBrush}"
                               IsVisible="{Binding ImportError}" />

                    <!-- 迁移明细：展开查看每一条导入/跳过的内容 -->
                    <Expander Header="查看迁移详情"
                              HorizontalAlignment="Stretch"
                              Margin="12 8"
                              IsVisible="{Binding HasMigrationDetails}">
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="4"
                                Padding="8"
                                Margin="0 4 0 0">
                            <ScrollViewer MaxHeight="200">
                                <ItemsControl ItemsSource="{Binding MigrationDetails}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MigrationDetailRow">
                                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0 3">
                                                <Grid.Styles>
                                                    <Style Selector="TextBlock.detail">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        <Setter Property="FontSize" Value="11" />
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                    </Style>
                                                </Grid.Styles>
                                                <Path Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                                                      Width="13" Height="13" Stretch="Uniform"
                                                      Margin="0 0 6 0"
                                                      VerticalAlignment="Top"
                                                      Fill="#10B981"
                                                      IsVisible="{Binding Imported}" />
                                                <Path Grid.Column="0" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-5.5 14.5L8 18l4-4 4 4 1.5-1.5-4-4 4-4L16 7l-4 4-4-4-1.5 1.5 4 4-4 4z"
                                                      Width="13" Height="13" Stretch="Uniform"
                                                      Margin="0 0 6 0"
                                                      VerticalAlignment="Top"
                                                      Fill="{DynamicResource TextSecondaryBrush}"
                                                      IsVisible="{Binding Skipped}" />
                                                <Path Grid.Column="0" Data="M12 2L1 21h22L12 2zm1 15h-2v2h2v-2zm0-6h-2v4h2v-4z"
                                                      Width="13" Height="13" Stretch="Uniform"
                                                      Margin="0 0 6 0"
                                                      VerticalAlignment="Top"
                                                      Fill="{DynamicResource WarningBrush}"
                                                      IsVisible="{Binding Warning}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                           Classes="detail"
                                                           Margin="8 0 0 0"
                                                           VerticalAlignment="Top" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Expander>

                    <Button Command="{Binding FinishCommand}"
                            ToolTip.Tip="完成"
                            Width="48" Height="48"
                            CornerRadius="24"
                            Classes="accent"
                            HorizontalAlignment="Center"
                            Margin="0 8 0 0">
                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                              Width="18" Height="18" Stretch="Uniform"
                              Fill="White" />
                    </Button>
                </StackPanel>
            </Border>
        </Carousel>
    </Grid>

</UserControl>

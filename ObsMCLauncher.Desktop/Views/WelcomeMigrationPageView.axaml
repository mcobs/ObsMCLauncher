<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="480"
             x:Class="ObsMCLauncher.Desktop.Views.WelcomeMigrationPageView"
             x:DataType="vm:WelcomeMigrationPageViewModel">

    <UserControl.Styles>
        <!-- 紧凑复选框：小图标 + 标题 + 描述（仿 ClassIsland） -->
        <Style Selector="CheckBox">
            <Setter Property="Padding" Value="4 6" />
        </Style>
        <Style Selector="CheckBox TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <!-- 仿 ClassIsland 数据迁移向导：Carousel 分步（选来源 → 配置导入 → 导入中 → 完成） -->
    <Grid Width="600" VerticalAlignment="Stretch" HorizontalAlignment="Center">
        <Carousel SelectedIndex="{Binding PageIndex}"
                  VerticalAlignment="Stretch">

            <Carousel.PageTransition>
                <CompositePageTransition>
                    <PageSlide Duration="0:0:0.3" Orientation="Horizontal" />
                    <CrossFade Duration="0:0:0.3" />
                </CompositePageTransition>
            </Carousel.PageTransition>

            <!-- 页 0：选择导入来源 -->
            <Border VerticalAlignment="Center">
                <StackPanel Spacing="2">
                    <TextBlock Text="数据迁移" HorizontalAlignment="Center"
                               Margin="0 0 0 4"
                               FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="向 ObsMCLauncher 导入数据。"
                               HorizontalAlignment="Center"
                               Margin="0 0 0 12" />
                    <ui:SettingsExpander Header="Plain Craft Launcher 2"
                                         Description="导入应用设置、各版本游戏设置与外置登录服务器数据的位置见 PCL 目录"
                                         IsClickEnabled="True"
                                         MinHeight="64"
                                         Click="SourcePcl_OnClick">
                        <ui:SettingsExpander.IconSource>
                            <ui:FontIconSource Glyph="&#xE896;" />
                        </ui:SettingsExpander.IconSource>
                    </ui:SettingsExpander>
                    <ui:SettingsExpander Header="Hello Minecraft! Launcher (3.16+)"
                                         Description="新版配置格式（config 目录下的 JSON 文件）"
                                         IsClickEnabled="True"
                                         MinHeight="64"
                                         Click="SourceHmclNew_OnClick">
                        <ui:SettingsExpander.IconSource>
                            <ui:FontIconSource Glyph="&#xE713;" />
                        </ui:SettingsExpander.IconSource>
                    </ui:SettingsExpander>
                    <ui:SettingsExpander Header="Hello Minecraft! Launcher (≤3.15.x)"
                                         Description="旧版 hmcl.json 配置格式"
                                         IsClickEnabled="True"
                                         MinHeight="64"
                                         Click="SourceHmclLegacy_OnClick">
                        <ui:SettingsExpander.IconSource>
                            <ui:FontIconSource Glyph="&#xE896;" />
                        </ui:SettingsExpander.IconSource>
                    </ui:SettingsExpander>
                </StackPanel>
            </Border>

            <!-- 页 1：配置导入 -->
            <Border VerticalAlignment="Center">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="选择要导入的数据" HorizontalAlignment="Center"
                               Margin="0 0 0 4"
                               FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SourceDescription}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0 0 0 12" />

                    <!-- 来源主程序路径 -->
                    <StackPanel Spacing="6" Margin="0 0 0 8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="启动器主程序" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="浏览" Click="BrowseSourceButton_OnClick" />
                        </Grid>
                        <TextBox Text="{Binding SourceExecutablePath}"
                                 Watermark="{Binding ExecutableHint}"
                                 FontSize="12" />
                        <TextBlock Text="{Binding SourceHint}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <CheckBox IsChecked="{Binding ImportGameSettings}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ui:FontIcon Glyph="&#xE713;" FontSize="18"
                                         VerticalAlignment="Center" />
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="游戏设置" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="包括各实例的内存、Java 路径、JVM 参数与版本隔离设置。"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding ImportAppSettings}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ui:FontIcon Glyph="&#xEF27;" FontSize="18"
                                         VerticalAlignment="Center" />
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="应用设置" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="包括游戏文件夹、Java、内存、下载与更新等应用首选项。"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </CheckBox>

                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <Button Command="{Binding BackCommand}"
                                ToolTip.Tip="上一步"
                                Width="48" Height="48"
                                CornerRadius="24"
                                Margin="0 12 0 0">
                            <ui:SymbolIcon Symbol="ChevronLeft" FontSize="18" />
                        </Button>
                        <Button Command="{Binding StartImportCommand}"
                                ToolTip.Tip="开始导入"
                                Width="48" Height="48"
                                CornerRadius="24"
                                Classes="accent"
                                Margin="0 12 0 0">
                            <ui:SymbolIcon Symbol="ChevronRight" FontSize="18" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 页 2：导入中 -->
            <Border VerticalAlignment="Center">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="正在导入" HorizontalAlignment="Center"
                               Margin="0 0 0 4"
                               FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="请坐和放宽，导入很快就能完成。"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0 0 0 4" />
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="48" Height="48"
                                     Margin="0 8 0 0"
                                     HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 页 3：导入完成 -->
            <Border VerticalAlignment="Center">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ResultSummary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ImportError}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="480"
                               FontSize="12"
                               Foreground="{DynamicResource WarningBrush}"
                               IsVisible="{Binding ImportError}" />

                    <!-- 迁移明细：展开查看每一条导入/跳过的内容 -->
                    <Expander Header="查看迁移详情"
                              HorizontalAlignment="Stretch"
                              Margin="12 8"
                              IsVisible="{Binding HasMigrationDetails}">
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="4"
                                Padding="8"
                                Margin="0 4 0 0">
                            <ScrollViewer MaxHeight="200">
                                <ItemsControl ItemsSource="{Binding MigrationDetails}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MigrationDetailRow">
                                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0 3">
                                                <Grid.Styles>
                                                    <Style Selector="TextBlock.detail">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        <Setter Property="FontSize" Value="11" />
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                    </Style>
                                                </Grid.Styles>
                                                <ui:FontIcon Grid.Column="0" FontSize="13" Margin="0 0 6 0"
                                                             VerticalAlignment="Top"
                                                             Glyph="&#xE73E;"
                                                             Foreground="#10B981"
                                                             IsVisible="{Binding Imported}" />
                                                <ui:FontIcon Grid.Column="0" FontSize="13" Margin="0 0 6 0"
                                                             VerticalAlignment="Top"
                                                             Glyph="&#xE711;"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                                             IsVisible="{Binding Skipped}" />
                                                <ui:FontIcon Grid.Column="0" FontSize="13" Margin="0 0 6 0"
                                                             VerticalAlignment="Top"
                                                             Glyph="&#xE7BA;"
                                                             Foreground="{DynamicResource WarningBrush}"
                                                             IsVisible="{Binding Warning}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                                           Classes="detail"
                                                           Margin="8 0 0 0"
                                                           VerticalAlignment="Top" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Expander>

                    <Button Command="{Binding FinishCommand}"
                            ToolTip.Tip="完成"
                            Width="48" Height="48"
                            CornerRadius="24"
                            Classes="accent"
                            HorizontalAlignment="Center"
                            Margin="0 8 0 0">
                        <ui:FontIcon Glyph="&#xE73E;" FontSize="18" />
                    </Button>
                </StackPanel>
            </Border>
        </Carousel>
    </Grid>

</UserControl>

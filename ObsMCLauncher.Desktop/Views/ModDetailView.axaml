<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:conv="using:ObsMCLauncher.Desktop.Converters"
             x:Class="ObsMCLauncher.Desktop.Views.ModDetailView"
             x:DataType="vm:ModDetailViewModel"
             x:Name="Root">

  <UserControl.Resources>
    <conv:BitmapAssetValueConverter x:Key="BitmapConverter"/>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*" Margin="16">
    <!-- 顶部：返回按钮左上角 + 基本信息 -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
      <Button Content="返回"
              Command="{Binding BackCommand}"
              VerticalAlignment="Top"/>

      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource BorderBrush}">
            <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
          </Border>
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding AuthorDisplay}" FontSize="11" Opacity="0.7"/>
              <TextBlock Text="{Binding DownloadsDisplay}" FontSize="11" Opacity="0.7"/>
              <TextBlock Text="{Binding LastUpdateDisplay}" FontSize="11" Opacity="0.7"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <Button Grid.Column="2"
              Content="{Binding WebsiteButtonText}"
              Classes="ghost" FontSize="11"
              Command="{Binding OpenWebsiteCommand}"
              IsVisible="{Binding WebsiteUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              VerticalAlignment="Center"/>
    </Grid>

    <TextBlock Grid.Row="1" Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,0,0,10" MaxLines="2"/>

    <Separator Grid.Row="2" Margin="0,0,0,10" Background="{DynamicResource DividerBrush}"/>

    <!-- 版本分组列表 -->
    <Grid Grid.Row="2">
      <Grid RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="可用版本" FontSize="16" FontWeight="Medium" Margin="0,0,0,6"/>

        <!-- 加载器筛选栏 -->
        <ListBox Grid.Row="1" ItemsSource="{Binding AvailableLoaders}"
                 SelectedItem="{Binding SelectedLoaderFilter}"
                 Margin="0,0,0,8"
                 SelectionMode="Single"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 MaxHeight="32">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="3" Margin="2,1">
                <Image Source="{Binding IconUri, Converter={StaticResource BitmapConverter}}"
                       Width="14" Height="14" VerticalAlignment="Center"
                       IsVisible="{Binding IconUri, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Text="{Binding LoaderName}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Count, StringFormat='({0})'}" FontSize="9" Opacity="0.5" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2">
          <ScrollViewer IsVisible="{Binding IsVersionsVisible}">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding FilteredVersionGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Expander IsExpanded="{Binding IsLatest}"
                              Margin="0,0,0,4"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                      <Expander.Header>
                        <Grid ColumnDefinitions="*,Auto" Margin="2">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding McVersion}" FontSize="14" FontWeight="SemiBold"/>
                            <Border IsVisible="{Binding IsLatest}"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="3" Padding="5,1">
                              <TextBlock Text="最新" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                          </StackPanel>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding FileCountDisplay}"
                                     FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                        </Grid>
                      </Expander.Header>

                      <StackPanel>
                        <ItemsControl ItemsSource="{Binding FilteredLoaderGroups}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="0,0,0,6">
                                <Border CornerRadius="4" Padding="6,3" Margin="0,0,0,4"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        HorizontalAlignment="Left">
                                  <TextBlock Text="{Binding LoaderName}" FontSize="12" FontWeight="Medium" Opacity="0.7"/>
                                </Border>

                                <Border IsVisible="{Binding HasCommonDependencies}"
                                        CornerRadius="4" Padding="8,5" Margin="0,2,0,6"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        Opacity="0.9">
                                  <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding CommonDependenciesDisplay}" FontSize="11" FontWeight="Medium" Opacity="0.9"/>
                                    <ItemsControl ItemsSource="{Binding CommonDependencies}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,1,0,0">
                                            <Border Background="{Binding TypeTagColor}" CornerRadius="2" Padding="3,0" VerticalAlignment="Center">
                                              <TextBlock Text="{Binding TypeTag}" FontSize="9" Foreground="White" FontWeight="SemiBold"/>
                                            </Border>
                                            <Button Content="{Binding Name}" FontSize="11"
                                                    Padding="1,0"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    Command="{Binding #Root.DataContext.NavigateToDependencyCommand}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand">
                                              <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                  <TextBlock Text="{TemplateBinding Content}"
                                                             Foreground="{TemplateBinding Foreground}"
                                                             FontSize="{TemplateBinding FontSize}"
                                                             TextDecorations="Underline"
                                                             Cursor="Hand"/>
                                                </ControlTemplate>
                                              </Button.Template>
                                            </Button>
                                          </StackPanel>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Files}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <StackPanel>
                                        <Border CornerRadius="4" Padding="8,5" Margin="0,0,0,3"
                                                Background="{DynamicResource SurfaceElevatedBrush}">
                                          <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel>
                                              <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1,0,0">
                                                <TextBlock Text="{Binding DateDisplay}" FontSize="10" Opacity="0.5"/>
                                                <TextBlock Text="{Binding McVersionsDisplay}" FontSize="10" Opacity="0.5"/>
                                                <TextBlock Text="{Binding SizeDisplay}" FontSize="10" Opacity="0.5"/>
                                              </StackPanel>
                                              <StackPanel IsVisible="{Binding HasDependencies}" Margin="0,2,0,0" Spacing="2">
                                                <ItemsControl ItemsSource="{Binding Dependencies}">
                                                  <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                      <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <Border Background="{Binding TypeTagColor}" CornerRadius="2" Padding="2,0" VerticalAlignment="Center">
                                                          <TextBlock Text="{Binding TypeTag}" FontSize="8" Foreground="White" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Button Content="{Binding Name}" FontSize="10"
                                                                Padding="0"
                                                                Foreground="{DynamicResource AccentBrush}"
                                                                Command="{Binding #Root.DataContext.NavigateToDependencyCommand}"
                                                                CommandParameter="{Binding}"
                                                                Cursor="Hand">
                                                          <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                              <TextBlock Text="{TemplateBinding Content}"
                                                                         Foreground="{TemplateBinding Foreground}"
                                                                         FontSize="{TemplateBinding FontSize}"
                                                                         TextDecorations="Underline"
                                                                         Cursor="Hand"/>
                                                            </ControlTemplate>
                                                          </Button.Template>
                                                        </Button>
                                                      </StackPanel>
                                                    </DataTemplate>
                                                  </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                              </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="下载"
                                                    FontSize="11"
                                                    Classes="accent"
                                                    Command="{Binding #Root.DataContext.DownloadVersionCommand}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center" Margin="8,0,0,0"/>
                                          </Grid>
                                        </Border>
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}">
            <ProgressBar IsIndeterminate="True" Width="60" Height="6"/>
            <TextBlock Text="加载中..." Margin="0,12,0,0" Opacity="0.8"/>
          </StackPanel>

          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmptyVisible}">
            <TextBlock Text="没有找到可用版本" FontSize="16" Opacity="0.8"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:conv="using:ObsMCLauncher.Desktop.Converters"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="ObsMCLauncher.Desktop.Views.ModDetailView"
             x:DataType="vm:ModDetailViewModel"
             x:Name="Root">

  <UserControl.Resources>
    <conv:BitmapAssetValueConverter x:Key="BitmapConverter"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- 加载器筛选 chips（选中态为主题色胶囊） -->
    <Style Selector="ListBox.loader-filter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="MaxHeight" Value="36"/>
    </Style>
    <Style Selector="ListBox.loader-filter ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.loader-filter ListBoxItem /template/ ContentPresenter">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.loader-filter ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="ListBox.loader-filter ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NavItemSelectedBackgroundBrush}"/>
    </Style>
    <Style Selector="ListBox.loader-filter ListBoxItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ListBox.loader-filter ListBoxItem TextBlock">
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 文件条目卡片 -->
    <Style Selector="Border.file-card">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- 加载器分组名胶囊 -->
    <Style Selector="Border.loader-chip">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- 前置资源行：沿用资源列表页 resource-row 的视觉语言，行高更紧凑 -->
    <Style Selector="Border.dependency-row">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CircularEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.dependency-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>

    <!-- 区块小标题（前置资源 / 版本列表） -->
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.section-count">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.dependency-meta">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="20">

    <!-- 返回按钮 -->
    <Button Grid.Row="0" Classes="ghost" Command="{Binding BackCommand}"
            HorizontalAlignment="Left" Margin="0,0,0,10" Padding="8,4">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ui:SymbolIcon Symbol="Back" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        <TextBlock Text="返回" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
      </StackPanel>
    </Button>

    <!-- 标题行 -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
        <Border Width="56" Height="56" CornerRadius="10"
                Background="{DynamicResource SurfaceElevatedBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
          <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
        </Border>
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Border Classes="tag" Background="{DynamicResource SurfaceElevatedBrush}">
              <TextBlock Text="{Binding SourceDisplay}" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ui:SymbolIcon Symbol="People" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding AuthorDisplay}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ui:SymbolIcon Symbol="Download" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding DownloadsDisplay}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4"
                        IsVisible="{Binding LastUpdateDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <ui:SymbolIcon Symbol="Calendar" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding LastUpdateDisplay}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <Button Grid.Column="1" Classes="ghost" Command="{Binding OpenWebsiteCommand}"
              IsVisible="{Binding WebsiteUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              VerticalAlignment="Center" Padding="10,6">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ui:SymbolIcon Symbol="Globe" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding WebsiteButtonText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- 摘要（可展开） -->
    <StackPanel Grid.Row="2" Margin="0,0,0,10">
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 MaxLines="{Binding SummaryMaxLines}" TextTrimming="CharacterEllipsis"/>
      <Button Classes="ghost" Command="{Binding ToggleSummaryCommand}"
              IsVisible="{Binding ShowSummaryToggle}" HorizontalAlignment="Left"
              Padding="0" Margin="0,2,0,0">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="{Binding SummaryToggleText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
          <ui:SymbolIcon Symbol="ChevronDown" FontSize="10" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- 下载 / 安装结果提示 -->
    <ui:InfoBar Grid.Row="3" IsOpen="{Binding IsInfoBarOpen}" Severity="{Binding InfoBarSeverity}"
                Title="{Binding InfoBarTitle}" Message="{Binding InfoBarMessage}"
                IsClosable="True" Margin="0,0,0,10"/>

    <Separator Grid.Row="4" Margin="0,0,0,12" Background="{DynamicResource DividerBrush}"/>

    <!-- 版本分组列表 -->
    <Grid Grid.Row="5">
      <Grid RowDefinitions="Auto,Auto,*">

        <TextBlock Grid.Row="0" Text="可用版本" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <!-- 加载器筛选栏 -->
        <ListBox Grid.Row="1" Classes="loader-filter"
                 ItemsSource="{Binding AvailableLoaders}"
                 SelectedItem="{Binding SelectedLoaderFilter}"
                 SelectionMode="Single">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2"/>
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="3" Margin="2,1">
                <Image Source="{Binding IconUri, Converter={StaticResource BitmapConverter}}"
                       Width="14" Height="14" VerticalAlignment="Center"
                       IsVisible="{Binding IconUri, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <TextBlock Text="{Binding LoaderName}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Count, StringFormat='({0})'}" FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2">
          <ScrollViewer IsVisible="{Binding IsVersionsVisible}">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding FilteredVersionGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:VersionGroupViewModel">
                    <Expander IsExpanded="{Binding IsLatest}"
                              Margin="0,0,0,4"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                      <Expander.Header>
                        <Grid ColumnDefinitions="*,Auto" Margin="2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding McVersion}" FontSize="14" FontWeight="SemiBold"/>
                            <Border Classes="tag tag-accent" IsVisible="{Binding IsLatest}">
                              <TextBlock Text="最新"/>
                            </Border>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding FileCountDisplay}" FontSize="12"
                                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                      </Expander.Header>

                      <StackPanel>
                        <!-- 前置资源：本 MC 版本组内所有文件、所有加载器合并去重（PCL 口径） -->
                        <StackPanel IsVisible="{Binding HasDependencies}" Margin="0,2,0,10">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Classes="section-title" Text="前置资源"/>
                            <TextBlock Grid.Column="1" Classes="section-count" Text="{Binding DependenciesDisplay}"/>
                          </Grid>

                          <ItemsControl ItemsSource="{Binding VisibleDependencies}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:DependencyItemViewModel">
                                <Border Classes="dependency-row" Tapped="OnDependencyRowTapped">
                                  <Grid ColumnDefinitions="Auto,*,Auto">

                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                            Background="{DynamicResource SurfaceHoverBrush}" VerticalAlignment="Center">
                                      <Grid>
                                        <ui:SymbolIcon Symbol="Library" FontSize="15"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Icon}" Width="36" Height="36"/>
                                      </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                      <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="280" VerticalAlignment="Center"/>
                                        <Border Classes="tag" Background="{Binding SourceTagColor}">
                                          <TextBlock Text="{Binding SourceTag}"/>
                                        </Border>
                                        <Border Classes="tag" Background="{Binding TypeTagColor}">
                                          <TextBlock Text="{Binding TypeTag}"/>
                                        </Border>
                                      </StackPanel>

                                      <TextBlock Text="{Binding Description}" FontSize="12" MaxLines="1"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                 TextTrimming="CharacterEllipsis"
                                                 IsVisible="{Binding IsResolved}"/>
                                      <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                 Foreground="{DynamicResource TextTertiaryBrush}"
                                                 TextTrimming="CharacterEllipsis"
                                                 IsVisible="{Binding !IsResolved}"/>

                                      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,1,0,0"
                                                  IsVisible="{Binding IsResolved}">
                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                    IsVisible="{Binding AuthorDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                          <ui:SymbolIcon Symbol="People" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                          <TextBlock Classes="dependency-meta" Text="{Binding AuthorDisplay}"
                                                     MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                    IsVisible="{Binding DownloadsDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                          <ui:SymbolIcon Symbol="Download" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                          <TextBlock Classes="dependency-meta" Text="{Binding DownloadsDisplay}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                    IsVisible="{Binding LastUpdateDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                          <ui:SymbolIcon Symbol="Calendar" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                          <TextBlock Classes="dependency-meta" Text="{Binding LastUpdateDisplay}"/>
                                        </StackPanel>
                                      </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                                VerticalAlignment="Center" IsVisible="{Binding CanNavigate}">
                                      <TextBlock Text="详情" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                      <ui:SymbolIcon Symbol="ChevronRight" FontSize="10" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <Button Classes="link" FontSize="11" HorizontalAlignment="Left" Margin="0,2,0,0"
                                  Command="{Binding ToggleDependenciesCommand}"
                                  IsVisible="{Binding HasMoreDependencies}"
                                  Content="{Binding DependenciesToggleText}"/>
                        </StackPanel>

                        <!-- 版本列表：与前置区块分开，避免两者混在一起 -->
                        <TextBlock Classes="section-title" Text="版本列表" Margin="0,0,0,6"
                                   IsVisible="{Binding HasDependencies}"/>

                        <ItemsControl ItemsSource="{Binding FilteredLoaderGroups}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LoaderSubGroupViewModel">
                              <StackPanel Margin="0,0,0,6">

                                <Border Classes="loader-chip">
                                  <TextBlock Text="{Binding LoaderName}" FontSize="12" FontWeight="Medium"
                                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Files}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VersionEntryViewModel">
                                      <Border Classes="file-card">
                                        <Grid ColumnDefinitions="*,Auto">
                                          <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                              <TextBlock Text="{Binding DateDisplay}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                              <TextBlock Text="{Binding McVersionsDisplay}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                              <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                            </StackPanel>
                                          </StackPanel>

                                          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDownloading}" VerticalAlignment="Center">
                                              <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" IsActive="True"/>
                                              <TextBlock Text="下载中..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <Border Classes="tag" Background="{DynamicResource SuccessBrush}" IsVisible="{Binding IsDownloaded}">
                                              <TextBlock Text="已下载"/>
                                            </Border>
                                            <Button Content="下载" Classes="accent" FontSize="12" Padding="14,6"
                                                    IsEnabled="{Binding !IsDownloading}"
                                                    Command="{Binding #Root.DataContext.DownloadVersionCommand}"
                                                    CommandParameter="{Binding}"/>
                                          </StackPanel>
                                        </Grid>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- 加载中 -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}" Spacing="12">
            <ui:ProgressRing Width="40" Height="40" IsIndeterminate="True" IsActive="True" HorizontalAlignment="Center"/>
            <TextBlock Text="正在加载版本信息..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>

          <!-- 空状态 -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsEmptyVisible}" Classes="empty-state">
            <ui:SymbolIcon Symbol="Find" FontSize="36" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="没有找到可用版本" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center"/>
            <TextBlock Text="该资源可能不支持当前筛选条件" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>

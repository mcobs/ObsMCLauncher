<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:converters="using:ObsMCLauncher.Desktop.Converters"
             xmlns:models="using:ObsMCLauncher.Core.Models"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="ObsMCLauncher.Desktop.Views.AccountManagementView"
             x:DataType="vm:AccountManagementViewModel"
             x:Name="AccountPage">

  <UserControl.Styles>
    <!-- 新增账号后的短暂高亮 -->
    <Style Selector="Border.account-card">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.3" Easing="CircularEaseOut"/>
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.3" Easing="CircularEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.account-card.highlighted">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BoxShadow" Value="0 0 0 3 #3310B981"/>
    </Style>
  </UserControl.Styles>

  <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*">

    <!-- ===== 页头 ===== -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="账号管理" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBlock Text="管理您的 Minecraft 账号，支持微软账户和离线模式" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />
    </StackPanel>

    <!-- ===== 添加账号 ===== -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="添加新账号" FontSize="16" FontWeight="Medium" Margin="0,0,0,4" />
          <TextBlock Text="登录微软账户、外置登录或创建离线账号" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <DropDownButton Grid.Column="1" Classes="accent" MinWidth="140" Height="44" Padding="16,10"
                        VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Path Data="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                  Width="16" Height="16" Stretch="Uniform" Fill="White" VerticalAlignment="Center"/>
            <TextBlock Text="添加账号" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
          <DropDownButton.Flyout>
            <MenuFlyout>
              <MenuItem Header="微软账户"
                        Command="{Binding StartMicrosoftLoginCommand}"
                        IsEnabled="{Binding !IsMicrosoftLoginRunning}">
                <MenuItem.Icon>
                  <Image Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                    <Image.Source>
                      <MultiBinding Converter="{x:Static converters:EnumToChineseTextConverter.Instance}" ConverterParameter="IconPath">
                        <Binding Source="{x:Static models:AccountType.Microsoft}" />
                        <Binding Path="ActualThemeVariant" RelativeSource="{RelativeSource Self}" />
                      </MultiBinding>
                    </Image.Source>
                  </Image>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="外置登录"
                        Command="{Binding AddYggdrasilAccountCommand}"
                        IsEnabled="{Binding !IsYggdrasilLoginRunning}">
                <MenuItem.Icon>
                  <Image Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                    <Image.Source>
                      <MultiBinding Converter="{x:Static converters:EnumToChineseTextConverter.Instance}" ConverterParameter="IconPath">
                        <Binding Source="{x:Static models:AccountType.Yggdrasil}" />
                        <Binding Path="ActualThemeVariant" RelativeSource="{RelativeSource Self}" />
                      </MultiBinding>
                    </Image.Source>
                  </Image>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="离线账户"
                        Command="{Binding ShowAddOfflinePanelCommand}"
                        IsEnabled="{Binding !IsAddOfflinePanelVisible}">
                <MenuItem.Icon>
                  <Image Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                    <Image.Source>
                      <MultiBinding Converter="{x:Static converters:EnumToChineseTextConverter.Instance}" ConverterParameter="IconPath">
                        <Binding Source="{x:Static models:AccountType.Offline}" />
                        <Binding Path="ActualThemeVariant" RelativeSource="{RelativeSource Self}" />
                      </MultiBinding>
                    </Image.Source>
                  </Image>
                </MenuItem.Icon>
              </MenuItem>
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
      </Grid>
    </Border>

    <!-- ===== 添加离线账号面板 ===== -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="12" Padding="24" Margin="0,0,0,20" IsVisible="{Binding IsAddOfflinePanelVisible}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
      <StackPanel>
        <TextBlock Text="添加离线账户" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" />
        <TextBlock Text="用户名" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
        <TextBox Watermark="请输入用户名（3-16个字符）" Text="{Binding UsernameInput}" FontSize="13" MaxLength="16" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
          <Button Content="取消" Command="{Binding CancelAddOfflineCommand}" />
          <Button Content="确认添加" Classes="accent" Command="{Binding AddOfflineCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ===== 账号列表（虚拟化 ListBox + 状态 InfoBar + 空状态） ===== -->
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <TextBlock Text="我的账号" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Width="220" Height="34" Padding="10,6" FontSize="12"
                 Watermark="搜索账号..." Text="{Binding SearchText}"/>
      </Grid>

      <ui:InfoBar Grid.Row="1"
                  IsOpen="{Binding Status, Converter={x:Static converters:StringNotEqualsConverter.Instance}, ConverterParameter=''}"
                  Message="{Binding Status}"
                  Severity="{Binding StatusSeverity}"
                  IsClosable="False"
                  IsIconVisible="True"
                  Margin="0,0,0,10"/>

      <Panel Grid.Row="2">
        <ListBox x:Name="AccountList"
                 ItemsSource="{Binding FilteredItems}"
                 Background="Transparent"
                 BorderThickness="0">
          <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Style Selector="^:pointerover">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
              <Style Selector="^:selected">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
            </ControlTheme>
          </ListBox.ItemContainerTheme>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AccountItemViewModel">
              <Border Classes="account-card"
                      Classes.highlighted="{Binding Account.IsHighlighted}"
                      Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                  <Panel Margin="0,0,16,0">
                    <Border Width="52" Height="52" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True">
                      <Image Source="{Binding Account.Avatar}" Stretch="Uniform" />
                    </Border>
                    <Border Width="22" Height="22"
                            CornerRadius="11"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderThickness="2"
                            BorderBrush="{DynamicResource SurfaceBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,-4,-4">
                      <Image Width="14" Height="14" Stretch="Uniform"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image.Source>
                          <MultiBinding Converter="{x:Static converters:EnumToChineseTextConverter.Instance}" ConverterParameter="IconPath">
                            <Binding Path="Account.Type" />
                            <Binding Path="ActualThemeVariant" RelativeSource="{RelativeSource Self}" />
                          </MultiBinding>
                        </Image.Source>
                      </Image>
                    </Border>
                  </Panel>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Account.Username}" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                      <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="6,1"
                              VerticalAlignment="Center"
                              Opacity="{Binding Account.IsDefault, Converter={x:Static converters:BoolToDoubleConverter.Instance}, ConverterParameter='1,0'}"
                              RenderTransform="{Binding Account.IsDefault, Converter={x:Static converters:BoolToTransformConverter.Instance}, ConverterParameter='scale(1)|scale(0.8)'}"
                              IsHitTestVisible="False">
                        <Border.Transitions>
                          <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CircularEaseOut"/>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CircularEaseOut"/>
                          </Transitions>
                        </Border.Transitions>
                        <TextBlock Text="默认" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                      </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Account.Type, Converter={x:Static converters:EnumToChineseTextConverter.Instance}}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <TextBlock Text="{Binding Account.TokenStatusText}" FontSize="12"
                                 Foreground="{Binding Account.TokenState, Converter={x:Static converters:TokenStateToBrushConverter.Instance}}"
                                 IsVisible="{Binding Account.HasTokenStatus}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Account.DetailText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Command="{Binding #AccountPage.DataContext.RefreshAccountCommand}"
                            CommandParameter="{Binding}"
                            Classes="ghost"
                            IsEnabled="{Binding CanRefresh}"
                            ToolTip.Tip="刷新账号"
                            AutomationProperties.Name="刷新账号">
                      <Panel Width="18" Height="18">
                        <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                              Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                              IsVisible="{Binding !IsRefreshing}"/>
                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16"
                                         Foreground="{DynamicResource AccentBrush}"
                                         IsVisible="{Binding IsRefreshing}"/>
                      </Panel>
                    </Button>
                    <Button Content="设为默认"
                            Classes="ghost"
                            Command="{Binding #AccountPage.DataContext.SetDefaultSelectedCommand}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding !Account.IsDefault, FallbackValue=False}"
                            FontSize="12"/>
                    <Button Classes="danger"
                            Command="{Binding #AccountPage.DataContext.DeleteSelectedCommand}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding CanDelete}"
                            FontSize="12">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Path Data="M9 3V4H4V6H5V19C5 20.1 5.9 21 7 21H17C18.1 21 19 20.1 19 19V6H20V4H15V3H9M7 6H17V19H7V6M9 8V17H11V8H9M13 8V17H15V8H13Z"
                              Width="12" Height="12" Stretch="Uniform" Fill="White"/>
                        <TextBlock Text="删除" Foreground="White"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- 空状态：无账号 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    IsVisible="{Binding ShowNoAccountsEmpty}">
          <Path Data="M12 12C14.21 12 16 10.21 16 8C16 5.79 14.21 4 12 4C9.79 4 8 5.79 8 8C8 10.21 9.79 12 12 12M12 14C9.33 14 4 15.34 4 18V20H20V18C20 15.34 14.67 14 12 14Z"
                Width="48" Height="48" Stretch="Uniform" Fill="{DynamicResource TextTertiaryBrush}" Opacity="0.5" HorizontalAlignment="Center"/>
          <TextBlock Text="还没有账号" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="点击右上角「添加账号」添加你的第一个账号" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 空状态：搜索无结果 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                    IsVisible="{Binding ShowNoSearchResultsEmpty}">
          <Path Data="M9.5 3C14.19 3 18 6.81 18 11.5C18 13.14 17.5 14.66 16.66 15.9L21 20.24L19.59 21.66L15.25 17.32C14 18.16 12.49 18.66 10.84 18.66C6.15 18.66 2.34 14.85 2.34 10.16C2.34 5.47 6.81 3 9.5 3M9.5 5C6.7 5 4.34 7.36 4.34 10.16C4.34 12.96 6.7 15.32 9.5 15.32C12.3 15.32 14.66 12.96 14.66 10.16C14.66 7.36 12.3 5 9.5 5Z"
                Width="48" Height="48" Stretch="Uniform" Fill="{DynamicResource TextTertiaryBrush}" Opacity="0.5" HorizontalAlignment="Center"/>
          <TextBlock Text="没有找到匹配的账号" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="换个关键词试试，或清除搜索" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
        </StackPanel>
      </Panel>
    </Grid>

    <!-- ===== 外置登录对话框（FluentAvalonia ContentDialog） =====
         用始终隐藏的 Panel 包住，避免视图显示时触发主题 :hidden 淡出动画导致弹窗闪现 -->
    <Panel IsVisible="False">
      <ui:ContentDialog x:Name="YggdrasilDialog"
                        Title="外置登录"
                        DefaultButton="None">
        <Grid RowDefinitions="*,Auto" Width="460">
          <Panel Grid.Row="0">

          <!-- 登录表单 -->
          <ScrollViewer IsVisible="{Binding !YggdrasilLoginDialog.ShowServerManagement}" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
              <TextBlock Text="认证服务器" FontSize="13" FontWeight="Medium"/>
              <ComboBox HorizontalAlignment="Stretch"
                        ItemsSource="{Binding YggdrasilLoginDialog.Servers}"
                        SelectedItem="{Binding YggdrasilLoginDialog.SelectedServer}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="models:YggdrasilServer">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="🛡" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Button Content="管理服务器" Classes="ghost" Command="{Binding YggdrasilLoginDialog.ToggleServerManagementCommand}"/>

              <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel Spacing="10">
                  <TextBlock Text="账号信息" FontSize="13" FontWeight="SemiBold"/>

                  <StackPanel Spacing="4">
                    <TextBlock Text="用户名/邮箱" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding YggdrasilLoginDialog.Username}" Watermark="请输入用户名或邮箱"/>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="密码" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding YggdrasilLoginDialog.Password}" PasswordChar="*" Watermark="请输入密码"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <ui:InfoBar IsOpen="True"
                          IsClosable="False"
                          Severity="Informational"
                          Message="外置登录需要在第三方认证服务器注册账号。推荐使用 LittleSkin 服务。"/>
            </StackPanel>
          </ScrollViewer>

          <!-- 服务器管理 -->
          <ScrollViewer IsVisible="{Binding YggdrasilLoginDialog.ShowServerManagement}" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
              <Button Classes="ghost" Command="{Binding YggdrasilLoginDialog.ToggleServerManagementCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="返回登录" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <TextBlock Text="管理认证服务器" FontSize="18" FontWeight="Bold"/>

              <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="16" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel Spacing="10">
                  <TextBlock Text="添加新服务器" FontWeight="Medium"/>
                  <TextBox Text="{Binding YggdrasilLoginDialog.NewServerName}" Watermark="服务器名称"/>
                  <TextBox Text="{Binding YggdrasilLoginDialog.NewServerUrl}" Watermark="服务器地址 (如 littleskin.cn)"/>
                  <Button Content="添加" Classes="accent" HorizontalAlignment="Right" Command="{Binding YggdrasilLoginDialog.AddServerCommand}"/>
                </StackPanel>
              </Border>

              <ItemsControl ItemsSource="{Binding YggdrasilLoginDialog.Servers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:YggdrasilServer">
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                          <TextBlock Text="{Binding ApiUrl}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="删除"
                                Command="{Binding $parent[ItemsControl].((vm:AccountManagementViewModel)DataContext).YggdrasilLoginDialog.DeleteServerCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding !IsBuiltIn}" Classes="danger" FontSize="12"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- 登录中遮罩 -->
          <Border Background="{DynamicResource BackgroundBrush}" Opacity="0.85" IsVisible="{Binding YggdrasilLoginDialog.IsLoggingIn}" CornerRadius="8">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
              <ProgressBar IsIndeterminate="True" Width="100"/>
              <TextBlock Text="{Binding YggdrasilLoginDialog.StatusMessage}" HorizontalAlignment="Center" FontSize="13"/>
            </StackPanel>
          </Border>

          <!-- 角色选择遮罩 -->
          <Border Background="{DynamicResource BackgroundBrush}" Opacity="0.95" IsVisible="{Binding YggdrasilLoginDialog.ShowProfileSelection}" CornerRadius="8">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="350">
              <TextBlock Text="选择角色" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock Text="此账号有多个游戏角色，请选择一个" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap"/>

              <ItemsControl ItemsSource="{Binding YggdrasilLoginDialog.AvailableProfiles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileItem">
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                      <RadioButton GroupName="ProfileGroup"
                                   Content="{Binding Name}"
                                   IsChecked="{Binding IsSelected}"
                                   FontSize="13" FontWeight="Medium"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0">
                <Button Content="取消" MinWidth="80" Command="{Binding YggdrasilLoginDialog.CancelProfileSelectionCommand}"/>
                <Button Content="确认" MinWidth="80" Classes="accent" Command="{Binding YggdrasilLoginDialog.ConfirmProfileCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Panel>

        <!-- 底部操作 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,20,0,0">
          <Button Content="取消" Width="100" Command="{Binding CancelYggdrasilLoginCommand}"/>
          <Button Content="登录" Width="100" Classes="accent"
                  Command="{Binding YggdrasilLoginDialog.LoginCommand}"
                  IsVisible="{Binding !YggdrasilLoginDialog.ShowServerManagement}"/>
        </StackPanel>
      </Grid>
      </ui:ContentDialog>
    </Panel>
  </Grid>

</UserControl>

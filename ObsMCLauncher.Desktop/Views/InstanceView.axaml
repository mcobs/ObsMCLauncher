<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:views="using:ObsMCLauncher.Desktop.Views"
             xmlns:services="using:ObsMCLauncher.Desktop.Services"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:converters="using:ObsMCLauncher.Desktop.Converters"
             x:Class="ObsMCLauncher.Desktop.Views.InstanceView"
             x:DataType="vm:InstanceViewModel">

  <Panel IsVisible="{Binding IsVisible}"
         ZIndex="10"
         HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch">
    <Border Background="{DynamicResource BackgroundBrush}">
    <Grid RowDefinitions="Auto,*">
      <!-- 顶部标题栏 -->
      <Border Grid.Row="0"
              Background="{DynamicResource SurfaceBrush}"
              Padding="16,10"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource BorderBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Command="{Binding CloseCommand}" Classes="ghost">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="返回" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <TextBlock Grid.Column="1"
                     Text="{Binding VersionId}"
                     FontSize="16"
                     FontWeight="Medium"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- 内容区：FluentAvalonia TabView -->
      <ui:TabView Grid.Row="1"
                  Background="{DynamicResource TabViewBackground}"
                  IsAddTabButtonVisible="False"
                  CanDragTabs="False"
                  CanReorderTabs="False"
                  IsVisible="{Binding !IsLoading}">

        <!-- ===== 基本信息 ===== -->
        <ui:TabViewItem Header="基本信息" IsClosable="False">
          <ui:TabViewItem.IconSource>
            <ui:PathIconSource Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </ui:TabViewItem.IconSource>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">
              <StackPanel Spacing="14">
                <StackPanel Spacing="6">
                  <TextBlock Text="基本信息" FontSize="14" FontWeight="Medium"/>
                  <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
                    <StackPanel>
                      <TextBlock Text="实际版本" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,3"/>
                      <TextBlock Text="{Binding ActualVersion}" FontSize="13" FontWeight="Medium"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                      <TextBlock Text="版本类型" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding VersionType}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                      <TextBlock Text="上次游玩" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,3" HorizontalAlignment="Right"/>
                      <TextBlock Text="{Binding LastPlayed}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>

                <Separator Background="{DynamicResource DividerBrush}"/>

                <!-- 版本描述 -->
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="版本描述" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="ghost" FontSize="11" Padding="8,4"
                            Command="{Binding StartEditDescriptionCommand}"
                            IsVisible="{Binding !IsEditingDescription}">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                              Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="编辑" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </Grid>
                  <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             IsVisible="{Binding !IsEditingDescription}"/>
                  <StackPanel IsVisible="{Binding IsEditingDescription}" Spacing="8">
                    <TextBox Text="{Binding EditingDescription}" AcceptsReturn="True" TextWrapping="Wrap"
                             Watermark="输入版本描述..." MinHeight="80" MaxWidth="600"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                      <Button Content="取消" Classes="ghost" Command="{Binding CancelEditDescriptionCommand}"/>
                      <Button Content="保存" Command="{Binding SaveDescriptionCommand}"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>

                <Separator Background="{DynamicResource DividerBrush}"/>

                <!-- 存储路径 -->
                <StackPanel Spacing="8">
                  <TextBlock Text="存储路径" FontSize="14" FontWeight="Medium"/>
                  <Border Background="{DynamicResource LayerFillColorPrimaryBrush}" CornerRadius="6" Padding="10,8"
                          BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding StoragePath}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                      <Button Grid.Column="1" Classes="ghost" Padding="6,4" VerticalAlignment="Center"
                              Command="{Binding OpenFolderCommand}" ToolTip.Tip="打开文件夹">
                        <Path Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z"
                              Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                      </Button>
                    </Grid>
                  </Border>
                </StackPanel>

                <Separator Background="{DynamicResource DividerBrush}"/>

                <!-- 快捷操作 -->
                <StackPanel Spacing="8">
                  <TextBlock Text="快捷操作" FontSize="14" FontWeight="Medium"/>
                  <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Left">
                    <Button Classes="ghost" Padding="10,6" Command="{Binding OpenModsFolderCommand}" ToolTip.Tip="打开Mod文件夹">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Path Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z"
                              Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Mod" FontSize="12" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="ghost" Padding="10,6" Command="{Binding OpenShaderPacksFolderCommand}" ToolTip.Tip="打开Shader文件夹">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Path Data="M21 3H3C1.9 3 1 3.9 1 5V19C1 20.1 1.9 21 3 21H21C22.1 21 23 20.1 23 19V5C23 3.9 22.1 3 21 3M21 19H3V5H21V19M7.5 13.5L10 16.5L14 11.5L19 17H5L7.5 13.5Z"
                              Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Shader" FontSize="12" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="ghost" Padding="10,6" Command="{Binding OpenResourcePacksFolderCommand}" ToolTip.Tip="打开资源包文件夹">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Path Data="M11 21h2v-3h-2v3zM5 21h2v-3H5v3zM17 21h2v-3h-2v3zM5 17h2v-3H5v3zM17 17h2v-3h-2v3zM5 13h2v-3H5v3zM17 13h2v-3h-2v3zM11 17h2v-3h-2v3zM11 13h2v-3h-2v3zM11 9h2V6h2V4h-2V1h-2v3H9v2h2v3z"
                              Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="资源包" FontSize="12" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="ghost" Padding="10,6" Command="{Binding OpenConfigFolderCommand}" ToolTip.Tip="打开配置文件夹">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                              Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="配置" FontSize="12" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>

                <Separator Background="{DynamicResource DividerBrush}"/>

                <!-- ===== 高级管理 ===== -->
                <StackPanel Spacing="10">
                  <TextBlock Text="高级管理" FontSize="14" FontWeight="Medium"/>
                  <TextBlock Text="版本运维工具，请谨慎操作" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" Margin="0,4,0,0">
                    <Button Classes="ghost" Padding="8,10" Command="{Binding ExportLaunchScriptCommand}">
                      <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <Path Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                              Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="导出启动脚本" FontSize="12"/>
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="ghost" Padding="8,10" Command="{Binding CompleteFilesCommand}">
                      <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <Path Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"
                              Width="18" Height="18" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="补全文件" FontSize="12"/>
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="danger" Padding="8,10" Command="{Binding DeleteVersionCommand}">
                      <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                              Width="18" Height="18" Stretch="Uniform" Fill="White"/>
                        <TextBlock Text="删除版本" FontSize="12" Foreground="White"/>
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </ui:TabViewItem>

        <!-- ===== 版本设置 ===== -->
        <ui:TabViewItem Header="版本设置" IsClosable="False">
          <ui:TabViewItem.IconSource>
            <ui:PathIconSource Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
          </ui:TabViewItem.IconSource>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">
              <StackPanel Spacing="14">
                <!-- 版本隔离与分组 -->
                <StackPanel Spacing="10">
                  <TextBlock Text="版本隔离与分组" FontSize="14" FontWeight="Medium"/>

                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="版本隔离" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="开启后此版本使用独立的游戏目录" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" Width="140" SelectedIndex="{Binding IsolationMode}" FontSize="12">
                      <ComboBoxItem Content="跟随全局"/>
                      <ComboBoxItem Content="开启"/>
                      <ComboBoxItem Content="关闭"/>
                    </ComboBox>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="版本分组" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Text="将此版本分配到指定分组" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                      <ComboBox Width="160"
                                ItemsSource="{Binding GroupListItems}"
                                SelectedItem="{Binding SelectedGroupItem}"
                                FontSize="12">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Classes="ghost" Padding="10,0" Command="{Binding OpenGroupManagerCommand}" ToolTip.Tip="管理分组">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Path Data="M19.14 12.94C19.18 12.64 19.2 12.33 19.2 12C19.2 11.68 19.18 11.36 19.13 11.06L21.16 9.48C21.34 9.34 21.39 9.07 21.28 8.87L19.36 5.55C19.24 5.33 18.99 5.26 18.77 5.33L16.38 6.29C15.88 5.91 15.35 5.59 14.76 5.35L14.4 2.81C14.36 2.57 14.16 2.4 13.92 2.4H10.08C9.84 2.4 9.65 2.57 9.61 2.81L9.25 5.35C8.66 5.59 8.12 5.92 7.63 6.29L5.24 5.33C5.02 5.25 4.77 5.33 4.65 5.55L2.74 8.87C2.62 9.08 2.66 9.34 2.86 9.48L4.89 11.06C4.84 11.36 4.8 11.69 4.8 12C4.8 12.31 4.82 12.64 4.87 12.94L2.85 14.52C2.67 14.66 2.62 14.93 2.73 15.13L4.65 18.45C4.77 18.67 5.02 18.74 5.24 18.67L7.63 17.71C8.13 18.09 8.66 18.41 9.25 18.65L9.61 21.19C9.65 21.43 9.84 21.6 10.08 21.6H13.92C14.16 21.6 14.36 21.43 14.4 21.19L14.76 18.65C15.35 18.41 15.89 18.09 16.38 17.71L18.77 18.67C18.99 18.74 19.24 18.67 19.36 18.45L21.28 15.13C21.39 14.91 21.34 14.66 21.16 14.52L19.14 12.94ZM12 15.6C10.02 15.6 8.4 13.98 8.4 12C8.4 10.02 10.02 8.4 12 8.4C13.98 8.4 15.6 10.02 15.6 12C15.6 13.98 13.98 15.6 12 15.6Z"
                                Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                          <TextBlock Text="管理分组" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                </StackPanel>

                <Separator Background="{DynamicResource DividerBrush}"/>

                <!-- 内存配置 -->
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="内存配置" FontSize="14" FontWeight="Medium"/>
                      <TextBlock Text="{Binding GlobalMemoryText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomMemory}" OnContent="自定义" OffContent="跟随全局"/>
                  </Grid>

                  <StackPanel Spacing="10" IsVisible="{Binding UseCustomMemory}">
                    <Separator Background="{DynamicResource DividerBrush}"/>
                    <!-- 最大内存 -->
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="最大内存" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding CustomMaxMemory}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                          <TextBlock Text="MB" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,110">
                        <Slider Grid.Column="0" Minimum="512" Maximum="16384" Value="{Binding CustomMaxMemory}"/>
                        <ui:NumberBox Grid.Column="1" x:CompileBindings="False"
                                      Value="{Binding CustomMaxMemory, Mode=TwoWay}"
                                      Minimum="512" Maximum="16384"
                                      SmallChange="256" LargeChange="1024"
                                      SpinButtonPlacementMode="Compact"
                                      HorizontalAlignment="Stretch"/>
                      </Grid>
                    </StackPanel>
                    <!-- 最小内存 -->
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="最小内存" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding CustomMinMemory}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                          <TextBlock Text="MB" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,110">
                        <Slider Grid.Column="0" Minimum="256" Maximum="8192" Value="{Binding CustomMinMemory}"/>
                        <ui:NumberBox Grid.Column="1" x:CompileBindings="False"
                                      Value="{Binding CustomMinMemory, Mode=TwoWay}"
                                      Minimum="256" Maximum="8192"
                                      SmallChange="128" LargeChange="512"
                                      SpinButtonPlacementMode="Compact"
                                      HorizontalAlignment="Stretch"/>
                      </Grid>
                    </StackPanel>
                    <TextBlock Text="{Binding MemoryHint}"
                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding !IsMemoryHintWarning}"/>
                    <TextBlock Text="{Binding MemoryHint}"
                               FontSize="11" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding IsMemoryHintWarning}"/>
                  </StackPanel>
                </StackPanel>

                <Separator Background="{DynamicResource DividerBrush}"/>

                <!-- Java 与 JVM 参数 -->
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="Java 路径" FontSize="14" FontWeight="Medium"/>
                      <TextBlock Text="{Binding GlobalJavaText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomJava}" OnContent="自定义" OffContent="跟随全局"/>
                  </Grid>

                  <StackPanel Spacing="6" IsVisible="{Binding UseCustomJava}">
                    <Separator Background="{DynamicResource DividerBrush}"/>
                    <ComboBox ItemsSource="{Binding JavaOptions}"
                              SelectedItem="{Binding SelectedJavaOption}"
                              PlaceholderText="请选择 Java（扫描系统已安装的运行时）..."
                              HorizontalAlignment="Stretch"
                              FontSize="12">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="services:JavaOption">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="{Binding Display}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center"
                                       IsVisible="{Binding IsPathVisible}"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                          </Grid>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCustomJavaPath}">
                      <TextBox Grid.Column="0" Text="{Binding CustomJavaPath}" Watermark="javaw.exe / java 的完整路径"
                               FontSize="12" Margin="0,0,8,0"/>
                      <Button Grid.Column="1" Content="浏览" Width="72" Command="{Binding BrowseJavaCommand}"/>
                    </Grid>

                    <TextBlock Text="{Binding JavaPathHint}"
                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding !IsJavaPathWarning}"/>
                    <TextBlock Text="{Binding JavaPathHint}"
                               FontSize="11" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding IsJavaPathWarning}"/>
                  </StackPanel>

                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="JVM 参数" FontSize="14" FontWeight="Medium"/>
                      <TextBlock Text="{Binding GlobalJvmText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomJvm}" OnContent="自定义" OffContent="跟随全局"/>
                  </Grid>

                  <StackPanel Spacing="6" IsVisible="{Binding UseCustomJvm}">
                    <Separator Background="{DynamicResource DividerBrush}"/>
                    <TextBlock Text="自定义参数将完整替换全局参数" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <views:JvmArgumentsEditorView DataContext="{Binding JvmArgumentsEditor}" HorizontalAlignment="Stretch"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </ui:TabViewItem>

        <!-- ===== 存档 ===== -->
        <ui:TabViewItem Header="存档" IsClosable="False">
          <ui:TabViewItem.IconSource>
            <ui:PathIconSource Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2M12 20C7.59 20 4 16.41 4 12S7.59 4 12 4 20 7.59 20 12 16.41 20 12 20M11 7H13V13H11V7M11 15H13V17H11V15Z"/>
          </ui:TabViewItem.IconSource>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="存档管理" FontSize="14" FontWeight="Medium"/>
                  <Button Grid.Column="1" Classes="ghost" FontSize="11" Padding="4,2"
                          Command="{Binding OpenSavesFolderCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                      <Path Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="打开存档文件夹" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding Worlds}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource LayerFillColorPrimaryBrush}"
                              CornerRadius="6"
                              Padding="10"
                              Margin="0,0,0,6"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource CardBorderBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Width="40" Height="40" CornerRadius="4" Margin="0,0,10,0"
                                  Background="{DynamicResource SurfaceBrush}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource CardBorderBrush}"
                                  ClipToBounds="True">
                            <Panel>
                              <Path Data="M12 2C6.48 2 2 6.48 2 12S6.48 22 12 22 22 17.52 22 12 17.52 2 12 2M12 20C7.59 20 4 16.41 4 12S7.59 4 12 4 20 7.59 20 12 16.41 20 12 20M11 7H13V13H11V7M11 15H13V17H11V15Z"
                                    Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                              <Image Source="{Binding IconPath, Converter={x:Static converters:FilePathToBitmapConverter.Instance}}"
                                     Stretch="UniformToFill" Margin="2"/>
                            </Panel>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding GameVersion, StringFormat='版本: {0}'}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                              <TextBlock Text="{Binding WorldSizeDisplay, StringFormat='大小: {0}'}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding CreationTime, StringFormat='创建: {0:yyyy-MM-dd HH:mm}'}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                              <TextBlock Text="{Binding LastModified, StringFormat='修改: {0:yyyy-MM-dd HH:mm}'}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="暂无存档" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" IsVisible="{Binding !HasWorlds}"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </ui:TabViewItem>

        <!-- ===== Mod ===== -->
        <ui:TabViewItem Header="Mod" IsClosable="False">
          <ui:TabViewItem.IconSource>
            <ui:PathIconSource Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z"/>
          </ui:TabViewItem.IconSource>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Mod 管理" FontSize="14" FontWeight="Medium"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Classes="ghost" FontSize="11" Padding="4,2" Command="{Binding RefreshModsCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="刷新" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="ghost" FontSize="11" Padding="4,2" Command="{Binding OpenModsFolderCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <Path Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="打开Mod文件夹" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Mods}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource LayerFillColorPrimaryBrush}"
                              CornerRadius="6"
                              Padding="10"
                              Margin="0,0,0,6"
                              BorderThickness="1"
                              BorderBrush="{Binding HasConflict, Converter={x:Static converters:BoolToBrushConverter.ConflictBorder}}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Border Width="32" Height="32" CornerRadius="4" Margin="0,0,10,0"
                                  Background="{DynamicResource SurfaceBrush}"
                                  BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                                  ClipToBounds="True">
                            <Image Source="{Binding IconPath, Converter={x:Static converters:FilePathToBitmapConverter.Instance}}"
                                   Stretch="Uniform" Margin="3"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                              <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="3" Padding="4,1" IsVisible="{Binding HasConflict}">
                                <TextBlock Text="冲突" FontSize="9" Foreground="{DynamicResource DangerBrush}" FontWeight="Medium"/>
                              </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                              <TextBlock Text="{Binding ModId}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding ModId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                              <TextBlock Text="{Binding Version}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding Version, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                              <TextBlock Text="{Binding Loader}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding Loader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ConflictDescription}" FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="{Binding HasConflict}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding ConflictSuggestion}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" IsVisible="{Binding ConflictSuggestion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0,2,0,0"/>
                          </StackPanel>
                          <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled}" OnContent="" OffContent=""/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="暂无Mod" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" IsVisible="{Binding !HasMods}"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </ui:TabViewItem>

        <!-- ===== Shader ===== -->
        <ui:TabViewItem Header="Shader" IsClosable="False">
          <ui:TabViewItem.IconSource>
            <ui:PathIconSource Data="M21 3H3C1.9 3 1 3.9 1 5V19C1 20.1 1.9 21 3 21H21C22.1 21 23 20.1 23 19V5C23 3.9 22.1 3 21 3M21 19H3V5H21V19M7.5 13.5L10 16.5L14 11.5L19 17H5L7.5 13.5Z"/>
          </ui:TabViewItem.IconSource>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="光影管理" FontSize="14" FontWeight="Medium"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Classes="ghost" FontSize="11" Padding="4,2" Command="{Binding RefreshShaderPacksCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="刷新" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="ghost" FontSize="11" Padding="4,2" Command="{Binding OpenShaderPacksFolderCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <Path Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="打开文件夹" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding ShaderPacks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource LayerFillColorPrimaryBrush}"
                              CornerRadius="6" Padding="10" Margin="0,0,0,6"
                              BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                          <Border Width="32" Height="32" CornerRadius="4" Margin="0,0,10,0"
                                  Background="{DynamicResource SurfaceBrush}"
                                  BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" ClipToBounds="True">
                            <Panel>
                              <Path Data="M21 3H3C1.9 3 1 3.9 1 5V19C1 20.1 1.9 21 3 21H21C22.1 21 23 20.1 23 19V5C23 3.9 22.1 3 21 3M21 19H3V5H21V19M7.5 13.5L10 16.5L14 11.5L19 17H5L7.5 13.5Z"
                                    Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                              <Image Source="{Binding IconPath, Converter={x:Static converters:FilePathToBitmapConverter.Instance}}"
                                     Stretch="Uniform" Margin="3"/>
                            </Panel>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Size, StringFormat='{}{0:F0} KB'}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0"/>
                          </StackPanel>
                          <Button Grid.Column="2" Classes="ghost" Padding="4,2" Margin="4,0,0,0"
                                  Command="{Binding $parent[ItemsControl].((vm:InstanceViewModel)DataContext).DeleteShaderPackCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="删除">
                            <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                  Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                          </Button>
                          <ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled}" OnContent="" OffContent="" Margin="8,0,0,0"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="暂无光影" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" IsVisible="{Binding !HasShaderPacks}"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </ui:TabViewItem>

        <!-- ===== 材质包 ===== -->
        <ui:TabViewItem Header="材质包" IsClosable="False">
          <ui:TabViewItem.IconSource>
            <ui:PathIconSource Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z"/>
          </ui:TabViewItem.IconSource>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="材质包管理" FontSize="14" FontWeight="Medium"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Classes="ghost" FontSize="11" Padding="4,2" Command="{Binding RefreshResourcePacksCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="刷新" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="ghost" FontSize="11" Padding="4,2" Command="{Binding OpenResourcePacksFolderCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <Path Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="打开文件夹" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding ResourcePacks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource LayerFillColorPrimaryBrush}"
                              CornerRadius="6" Padding="10" Margin="0,0,0,6"
                              BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                          <Border Width="32" Height="32" CornerRadius="4" Margin="0,0,10,0"
                                  Background="{DynamicResource SurfaceBrush}"
                                  BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" ClipToBounds="True">
                            <Panel>
                              <Path Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z"
                                    Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                              <Image Source="{Binding IconPath, Converter={x:Static converters:FilePathToBitmapConverter.Instance}}"
                                     Stretch="Uniform" Margin="3"/>
                            </Panel>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Size, StringFormat='{}{0:F0} KB'}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0"/>
                          </StackPanel>
                          <Button Grid.Column="2" Classes="ghost" Padding="4,2" Margin="4,0,0,0"
                                  Command="{Binding $parent[ItemsControl].((vm:InstanceViewModel)DataContext).DeleteResourcePackCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="删除">
                            <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                  Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                          </Button>
                          <ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled}" OnContent="" OffContent="" Margin="8,0,0,0"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="暂无材质包" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" IsVisible="{Binding !HasResourcePacks}"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </ui:TabViewItem>

      </ui:TabView>

      <!-- 加载骨架屏 -->
      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Disabled"
                    IsVisible="{Binding IsLoading}">
        <StackPanel Margin="20" Spacing="14" MaxWidth="900" HorizontalAlignment="Stretch">
          <Border Classes="shimmer-line" Width="120" Height="14"/>

          <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
            <StackPanel Spacing="6">
              <Border Classes="shimmer-line" Width="56" Height="8"/>
              <Border Classes="shimmer-line" Width="96" Height="14"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Center">
              <Border Classes="shimmer-line" Width="56" Height="8"/>
              <Border Classes="shimmer-line" Width="72" Height="14"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right">
              <Border Classes="shimmer-line" Width="56" Height="8"/>
              <Border Classes="shimmer-line" Width="88" Height="14"/>
            </StackPanel>
          </Grid>

          <Separator Background="{DynamicResource DividerBrush}"/>

          <StackPanel Spacing="8">
            <Border Classes="shimmer-line" Width="72" Height="14"/>
            <Border Classes="shimmer" Padding="10,12" Height="44"/>
          </StackPanel>

          <Separator Background="{DynamicResource DividerBrush}"/>

          <StackPanel Spacing="8">
            <Border Classes="shimmer-line" Width="72" Height="14"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="shimmer" Width="84" Height="30"/>
              <Border Classes="shimmer" Width="84" Height="30"/>
              <Border Classes="shimmer" Width="84" Height="30"/>
            </StackPanel>
          </StackPanel>

          <Separator Background="{DynamicResource DividerBrush}"/>

          <StackPanel Spacing="8">
            <Border Classes="shimmer-line" Width="72" Height="14"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
              <Border Classes="shimmer" Height="64"/>
              <Border Grid.Column="1" Classes="shimmer" Height="64"/>
              <Border Grid.Column="2" Classes="shimmer" Height="64"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    </Border>

    <!-- 分组管理弹窗：FluentAvalonia ContentDialog。
         用始终隐藏的 Panel 包住，避免视图显示时触发主题 :hidden 淡出动画导致弹窗闪现 -->
    <Panel IsVisible="False">
      <ui:ContentDialog x:Name="GroupManagerDialog"
                        Title="分组管理"
                        CloseButtonText="关闭">
        <StackPanel Spacing="8" Width="380">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding ManagedGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource SurfaceBrush}"
                          CornerRadius="6" Padding="12,10" Margin="0,0,0,4"
                          BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                              Background="{DynamicResource SurfaceElevatedBrush}"
                              IsVisible="{Binding IsSystem}"
                              VerticalAlignment="Center">
                        <TextBlock Text="系统组" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}"/>
                      </Border>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                  IsVisible="{Binding IsDeletable}">
                        <Button Width="26" Height="26" Padding="0" Classes="ghost" ToolTip.Tip="重命名"
                                Command="{Binding $parent[ItemsControl].((vm:InstanceViewModel)DataContext).RenameGroupCommand}"
                                CommandParameter="{Binding}">
                          <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Width="26" Height="26" Padding="0" Classes="ghost" ToolTip.Tip="删除"
                                Command="{Binding $parent[ItemsControl].((vm:InstanceViewModel)DataContext).DeleteGroupCommand}"
                                CommandParameter="{Binding}">
                          <Path Data="M19 4H15.5L14.5 3H9.5L8.5 4H5V6H19M6 19A2 2 0 0 0 8 21H16A2 2 0 0 0 18 19V7H6V19Z"
                                Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource DangerBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <Grid ColumnDefinitions="*,Auto">
          <TextBox Watermark="输入新分组名称" Text="{Binding NewGroupName}" FontSize="13"/>
          <Button Grid.Column="1" Content="创建" Margin="8,0,0,0" Padding="14,0"
                  Command="{Binding CreateGroupCommand}"/>
        </Grid>
        </StackPanel>
      </ui:ContentDialog>
    </Panel>

  </Panel>
</UserControl>

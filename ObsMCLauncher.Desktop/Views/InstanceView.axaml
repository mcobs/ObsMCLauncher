<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:views="using:ObsMCLauncher.Desktop.Views"
             xmlns:services="using:ObsMCLauncher.Desktop.Services"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:converters="using:ObsMCLauncher.Desktop.Converters"
             x:Class="ObsMCLauncher.Desktop.Views.InstanceView"
             x:DataType="vm:InstanceViewModel">

  <Panel IsVisible="{Binding IsVisible}"
         ZIndex="10"
         HorizontalAlignment="Stretch"
         VerticalAlignment="Stretch">
    <!-- 覆盖层根透明：壁纸（WallpaperHost 的 Opacity=壁纸不透明度设置）直接透出来，
         与主页内容区一致；可读性由 Hero 卡 / TabView 标签条等自带底色的元素负责 -->
    <Border Background="Transparent">
    <Grid RowDefinitions="Auto,*">
      <!-- 顶部标题栏：返回 + 版本名（主标题）+ 关键信息徽章；半透明蒙层，与 TabView 标签条同款 -->
      <Border Grid.Row="0"
              Background="{DynamicResource InstanceHeaderBackgroundBrush}"
              Padding="20,14"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource DividerBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Command="{Binding CloseCommand}" Classes="ghost" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Data="M20 11H7.83L13.42 5.41L12 4L4 12L12 20L13.41 18.59L7.83 13H20V11Z"
                    Width="14" Height="14" Stretch="Uniform"
                    Fill="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="返回" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                      Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding VersionId}" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

            <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="10"
                    Padding="10,3" VerticalAlignment="Center" ToolTip.Tip="实际版本">
              <TextBlock Text="{Binding ActualVersion}" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
            <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="10"
                    Padding="10,3" VerticalAlignment="Center" ToolTip.Tip="版本类型">
              <TextBlock Text="{Binding VersionType}" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
            <Border Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="10"
                    Padding="10,3" VerticalAlignment="Center" ToolTip.Tip="上次游玩">
              <TextBlock Text="{Binding LastPlayed}" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 内容区：FluentAvalonia TabView -->
      <ui:TabView Grid.Row="1"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch"
                  Background="{DynamicResource TabViewBackground}"
                  IsAddTabButtonVisible="False"
                  CanDragTabs="False"
                  CanReorderTabs="False"
                  IsVisible="{Binding !IsLoading}">

        <!-- ===== 基本信息 ===== -->
        <ui:TabViewItem Header="基本信息" IsClosable="False">
          <ui:TabViewItem.IconSource>
            <ui:PathIconSource Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
          </ui:TabViewItem.IconSource>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,24" Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">

              <!-- ===== 版本 Hero ===== -->
              <Border Background="{DynamicResource LayerFillColorPrimaryBrush}"
                      CornerRadius="12" Padding="20"
                      BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                <StackPanel Spacing="14">

                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="56" Height="56" CornerRadius="10"
                            Background="{DynamicResource PrimarySoftBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                      <Image Source="{Binding LoaderIconPath, Converter={x:Static converters:BitmapAssetValueConverter.Instance}}"
                             Width="32" Height="32" Stretch="Uniform"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center" Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding VersionId}" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="9"
                                Padding="9,2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding VersionType}" FontSize="11" FontWeight="SemiBold"
                                     Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Description}" FontSize="12"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 IsVisible="{Binding !IsEditingDescription}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Classes="ghost" Content="编辑" FontSize="12" Padding="12,5"
                            VerticalAlignment="Top"
                            Command="{Binding StartEditDescriptionCommand}"
                            IsVisible="{Binding !IsEditingDescription}"/>
                  </Grid>

                  <!-- 编辑描述：就地展开，不弹窗 -->
                  <StackPanel Spacing="10" IsVisible="{Binding IsEditingDescription}">
                    <TextBox Text="{Binding EditingDescription}" AcceptsReturn="True" TextWrapping="Wrap"
                             Watermark="输入版本描述..." MinHeight="72"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                      <Button Content="取消" Classes="ghost" FontSize="12" Padding="12,5"
                              Command="{Binding CancelEditDescriptionCommand}"/>
                      <Button Content="保存" Classes="accent" FontSize="12" Padding="14,5"
                              Command="{Binding SaveDescriptionCommand}"/>
                    </StackPanel>
                  </StackPanel>

                  <Separator Background="{DynamicResource DividerBrush}" Margin="-20,0"/>

                  <Grid ColumnDefinitions="*,*,*">
                    <StackPanel Spacing="3">
                      <TextBlock Text="实际版本" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                      <TextBlock Text="{Binding ActualVersion}" FontSize="14" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3" Margin="24,0,0,0">
                      <TextBlock Text="版本类型" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                      <TextBlock Text="{Binding VersionType}" FontSize="14" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3" Margin="24,0,0,0">
                      <TextBlock Text="上次游玩" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                      <TextBlock Text="{Binding LastPlayed}" FontSize="14" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- ===== 快捷操作 ===== -->
              <StackPanel Spacing="8">
                <TextBlock Text="快捷操作" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                  <Button Grid.Column="0" Classes="secondary" Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding OpenModsFolderCommand}" ToolTip.Tip="打开 Mod 文件夹">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z"
                            Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="Mod" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="1" Classes="secondary" Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding OpenShaderPacksFolderCommand}" ToolTip.Tip="打开光影文件夹">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Data="M21 3H3C1.9 3 1 3.9 1 5V19C1 20.1 1.9 21 3 21H21C22.1 21 23 20.1 23 19V5C23 3.9 22.1 3 21 3M21 19H3V5H21V19M7.5 13.5L10 16.5L14 11.5L19 17H5L7.5 13.5Z"
                            Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="光影" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="2" Classes="secondary" Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding OpenResourcePacksFolderCommand}" ToolTip.Tip="打开材质包文件夹">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Data="M11 21h2v-3h-2v3zM5 21h2v-3H5v3zM17 21h2v-3h-2v3zM5 17h2v-3H5v3zM17 17h2v-3h-2v3zM5 13h2v-3H5v3zM17 13h2v-3h-2v3zM11 17h2v-3h-2v3zM11 13h2v-3h-2v3zM11 9h2V6h2V4h-2V1h-2v3H9v2h2v3z"
                            Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="材质包" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="3" Classes="secondary" Height="44" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          Command="{Binding OpenConfigFolderCommand}" ToolTip.Tip="打开配置文件夹">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                            Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="配置" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>

              <!-- ===== 存储路径 ===== -->
              <Border Background="{DynamicResource LayerFillColorPrimaryBrush}"
                      CornerRadius="8" Padding="14,11"
                      BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Text="存储路径" FontSize="12"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             VerticalAlignment="Center" Margin="0,0,16,0"/>
                  <TextBlock Grid.Column="1" Text="{Binding StoragePath}" FontSize="12" FontFamily="Consolas"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <Button Grid.Column="2" Classes="ghost" Content="打开" FontSize="12" Padding="10,4"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          Command="{Binding OpenFolderCommand}" ToolTip.Tip="在文件管理器中打开"/>
                </Grid>
              </Border>

              <!-- ===== 高级管理 ===== -->
              <StackPanel Spacing="8">
                <TextBlock Text="高级管理" FontSize="12" FontWeight="Medium"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="secondary" Content="导出启动脚本" FontSize="12" Padding="14,8"
                          Command="{Binding ExportLaunchScriptCommand}"/>
                  <Button Classes="secondary" Content="补全文件" FontSize="12" Padding="14,8"
                          Command="{Binding CompleteFilesCommand}"/>
                  <Button Content="删除版本" FontSize="12" Padding="14,8"
                          Background="{DynamicResource DangerSoftBrush}" Foreground="{DynamicResource DangerBrush}"
                          BorderThickness="0" CornerRadius="6" HorizontalContentAlignment="Center"
                          Command="{Binding DeleteVersionCommand}"
                          ToolTip.Tip="删除版本会连同游戏目录一起移除，不可撤销"/>
                </StackPanel>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </ui:TabViewItem>

        <!-- ===== 版本设置 ===== -->
        <ui:TabViewItem Header="版本设置" IsClosable="False">
          <ui:TabViewItem.IconSource>
            <ui:PathIconSource Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
          </ui:TabViewItem.IconSource>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,24" Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">

              <!-- ===== 版本隔离与分组 ===== -->
              <ui:SettingsExpander Header="版本隔离与分组"
                                   Description="决定这个版本用哪个游戏目录、归到哪个分组"
                                   IsExpanded="True">
                <ui:SettingsExpander.IconSource>
                  <ui:SymbolIconSource Symbol="FolderLink"/>
                </ui:SettingsExpander.IconSource>

                <ui:SettingsExpanderItem Content="版本隔离" Description="开启后此版本使用独立的游戏目录">
                  <ui:SettingsExpanderItem.Footer>
                    <ComboBox Width="160" SelectedIndex="{Binding IsolationMode}" FontSize="12">
                      <ComboBoxItem Content="跟随全局"/>
                      <ComboBoxItem Content="开启"/>
                      <ComboBoxItem Content="关闭"/>
                    </ComboBox>
                  </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>

                <ui:SettingsExpanderItem Content="版本分组" Description="将此版本分配到指定分组">
                  <ui:SettingsExpanderItem.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <ComboBox Width="180"
                                ItemsSource="{Binding GroupListItems}"
                                SelectedItem="{Binding SelectedGroupItem}"
                                FontSize="12">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Classes="ghost" Content="管理" FontSize="12" Padding="12,5"
                              Command="{Binding OpenGroupManagerCommand}" ToolTip.Tip="管理分组"/>
                    </StackPanel>
                  </ui:SettingsExpanderItem.Footer>
                </ui:SettingsExpanderItem>
              </ui:SettingsExpander>

              <!-- ===== 内存配置 ===== -->
              <ui:SettingsExpander Header="内存配置"
                                   Description="不开启时跟随全局设置中分配的内存"
                                   IsExpanded="True">
                <ui:SettingsExpander.IconSource>
                  <ui:SymbolIconSource Symbol="Calculator"/>
                </ui:SettingsExpander.IconSource>

                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding GlobalMemoryText}" FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomMemory}"
                                  OnContent="自定义" OffContent="跟随全局"/>
                  </Grid>

                  <StackPanel Spacing="12" IsVisible="{Binding UseCustomMemory}">
                    <!-- 最大内存 -->
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="最大内存" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding CustomMaxMemory}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                          <TextBlock Text="MB" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,110">
                        <Slider Grid.Column="0" Minimum="512" Maximum="16384" Value="{Binding CustomMaxMemory}"/>
                        <ui:NumberBox Grid.Column="1" x:CompileBindings="False"
                                      Value="{Binding CustomMaxMemory, Mode=TwoWay}"
                                      Minimum="512" Maximum="16384"
                                      SmallChange="256" LargeChange="1024"
                                      SpinButtonPlacementMode="Compact"
                                      HorizontalAlignment="Stretch"/>
                      </Grid>
                    </StackPanel>

                    <!-- 最小内存 -->
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="最小内存" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding CustomMinMemory}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                          <TextBlock Text="MB" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,110">
                        <Slider Grid.Column="0" Minimum="256" Maximum="8192" Value="{Binding CustomMinMemory}"/>
                        <ui:NumberBox Grid.Column="1" x:CompileBindings="False"
                                      Value="{Binding CustomMinMemory, Mode=TwoWay}"
                                      Minimum="256" Maximum="8192"
                                      SmallChange="128" LargeChange="512"
                                      SpinButtonPlacementMode="Compact"
                                      HorizontalAlignment="Stretch"/>
                      </Grid>
                    </StackPanel>

                    <ui:InfoBar IsOpen="{Binding IsMemoryHintWarning}" Severity="Warning"
                                IsClosable="False" Message="{Binding MemoryHint}"/>
                    <TextBlock Text="{Binding MemoryHint}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               IsVisible="{Binding !IsMemoryHintWarning}"/>
                  </StackPanel>
                </StackPanel>
              </ui:SettingsExpander>

              <!-- ===== Java 路径 ===== -->
              <ui:SettingsExpander Header="Java 路径"
                                   Description="不开启时跟随全局设置选择的 Java 运行时"
                                   IsExpanded="True">
                <ui:SettingsExpander.IconSource>
                  <ui:SymbolIconSource Symbol="Code"/>
                </ui:SettingsExpander.IconSource>

                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding GlobalJavaText}" FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomJava}"
                                  OnContent="自定义" OffContent="跟随全局"/>
                  </Grid>

                  <StackPanel Spacing="10" IsVisible="{Binding UseCustomJava}">
                    <ComboBox ItemsSource="{Binding JavaOptions}"
                              SelectedItem="{Binding SelectedJavaOption}"
                              PlaceholderText="请选择 Java（扫描系统已安装的运行时）..."
                              HorizontalAlignment="Stretch"
                              FontSize="12">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="services:JavaOption">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="{Binding Display}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center"
                                       IsVisible="{Binding IsPathVisible}"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                          </Grid>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCustomJavaPath}">
                      <TextBox Grid.Column="0" Text="{Binding CustomJavaPath}" Watermark="javaw.exe / java 的完整路径"
                               FontSize="12" Margin="0,0,8,0"/>
                      <Button Grid.Column="1" Content="浏览" Width="72" Command="{Binding BrowseJavaCommand}"/>
                    </Grid>

                    <ui:InfoBar IsOpen="{Binding IsJavaPathWarning}" Severity="Warning"
                                IsClosable="False" Message="{Binding JavaPathHint}"/>
                    <TextBlock Text="{Binding JavaPathHint}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               IsVisible="{Binding !IsJavaPathWarning}"/>
                  </StackPanel>
                </StackPanel>
              </ui:SettingsExpander>

              <!-- ===== JVM 参数 ===== -->
              <ui:SettingsExpander Header="JVM 参数"
                                   Description="不开启时跟随全局设置的启动参数"
                                   IsExpanded="True">
                <ui:SettingsExpander.IconSource>
                  <ui:SymbolIconSource Symbol="Ruler"/>
                </ui:SettingsExpander.IconSource>

                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding GlobalJvmText}" FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseCustomJvm}"
                                  OnContent="自定义" OffContent="跟随全局"/>
                  </Grid>

                  <StackPanel Spacing="6" IsVisible="{Binding UseCustomJvm}">
                    <TextBlock Text="自定义参数将完整替换全局参数" FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <views:JvmArgumentsEditorView DataContext="{Binding JvmArgumentsEditor}" HorizontalAlignment="Stretch"/>
                  </StackPanel>
                </StackPanel>
              </ui:SettingsExpander>

            </StackPanel>
          </ScrollViewer>
        </ui:TabViewItem>

        <!-- ===== 存档 ===== -->
        <!-- ===== 资源管理（存档 / Mod / 材质包 / 光影 合并为一个标签页，左侧导航切换） ===== -->
        <ui:TabViewItem Header="资源管理" IsClosable="False">
          <ui:TabViewItem.IconSource>
            <ui:PathIconSource Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z"/>
          </ui:TabViewItem.IconSource>
          <Grid ColumnDefinitions="Auto,*">
            <!-- 左侧二级导航：用 FluentAvalonia 原生 ListBox，
                 选中态交给控件主题（不再自绘按钮与激活类），背景与内容区一致、只留一条分隔线 -->
            <ListBox Grid.Column="0" Width="200"
                     Background="Transparent"
                     BorderThickness="0,0,1,0"
                     BorderBrush="{DynamicResource DividerBrush}"
                     Padding="6,10"
                     SelectedIndex="{Binding SelectedResourceTabIndex}">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Padding" Value="12,9"/>
                </Style>
              </ListBox.Styles>
              <ListBoxItem ToolTip.Tip="存档">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2M12 20C7.59 20 4 16.41 4 12S7.59 4 12 4 20 7.59 20 12 16.41 20 12 20M11 7H13V13H11V7M11 15H13V17H11V15Z" Width="16" Height="16" Stretch="Uniform"
                        Fill="{Binding $parent[ListBoxItem].Foreground}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="存档" FontSize="13"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <ui:InfoBadge Grid.Column="2" Value="{Binding Worlds.Count}" VerticalAlignment="Center"/>
                </Grid>
              </ListBoxItem>
              <ListBoxItem ToolTip.Tip="Mod">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Path Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z" Width="16" Height="16" Stretch="Uniform"
                        Fill="{Binding $parent[ListBoxItem].Foreground}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Mod" FontSize="13"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <ui:InfoBadge Grid.Column="2" Value="{Binding Mods.Count}" VerticalAlignment="Center"/>
                </Grid>
              </ListBoxItem>
              <ListBoxItem ToolTip.Tip="材质包">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Path Data="M21 19V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19M8.5 13.5L11 16.5L14.5 12L19 18H5L8.5 13.5Z" Width="16" Height="16" Stretch="Uniform"
                        Fill="{Binding $parent[ListBoxItem].Foreground}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="材质包" FontSize="13"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <ui:InfoBadge Grid.Column="2" Value="{Binding ResourcePacks.Count}" VerticalAlignment="Center"/>
                </Grid>
              </ListBoxItem>
              <ListBoxItem ToolTip.Tip="光影">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <Path Data="M21 3H3C1.9 3 1 3.9 1 5V19C1 20.1 1.9 21 3 21H21C22.1 21 23 20.1 23 19V5C23 3.9 22.1 3 21 3M21 19H3V5H21V19M7.5 13.5L10 16.5L14.5 11.5L19 17H5L7.5 13.5Z" Width="16" Height="16" Stretch="Uniform"
                        Fill="{Binding $parent[ListBoxItem].Foreground}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="光影" FontSize="13"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <ui:InfoBadge Grid.Column="2" Value="{Binding ShaderPacks.Count}" VerticalAlignment="Center"/>
                </Grid>
              </ListBoxItem>
            </ListBox>

            <!-- 右侧内容区：四个列表各自独立滚动，同一时刻只显示一个 -->
            <Panel Grid.Column="1">
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding SelectedResourceTabIndex, Converter={x:Static converters:TabIndexToBoolConverter.Instance}, ConverterParameter=0}">
                <StackPanel Margin="20,16,20,24" Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="存档" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="这个版本里的世界列表" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                      </StackPanel>
                      <Button Grid.Column="1" Classes="ghost" FontSize="12" Padding="12,5"
                              VerticalAlignment="Center"
                              Command="{Binding OpenSavesFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Path Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                          <TextBlock Text="打开文件夹" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Worlds}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource LayerFillColorPrimaryBrush}"
                                  CornerRadius="8"
                                  Padding="12"
                                  Margin="0,0,0,8"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource CardBorderBrush}">
                            <Grid ColumnDefinitions="Auto,*">
                              <Border Width="44" Height="44" CornerRadius="6" Margin="0,0,12,0"
                                      Background="{DynamicResource SurfaceBrush}"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource CardBorderBrush}"
                                      ClipToBounds="True">
                                <Panel>
                                  <Path Data="M12 2C6.48 2 2 6.48 2 12S6.48 22 12 22 22 17.52 22 12 17.52 2 12 2M12 20C7.59 20 4 16.41 4 12S7.59 4 12 4 20 7.59 20 12 16.41 20 12 20M11 7H13V13H11V7M11 15H13V17H11V15Z"
                                        Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                  <Image Source="{Binding IconPath, Converter={x:Static converters:FilePathToBitmapConverter.Instance}}"
                                         Stretch="UniformToFill"/>
                                </Panel>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"
                                          ToolTip.Tip="{Binding CreationTime, StringFormat='创建: {0:yyyy-MM-dd HH:mm}'}">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                  <TextBlock Text="{Binding GameVersion, StringFormat='版本 {0}'}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                  <TextBlock Text="{Binding WorldSizeDisplay, StringFormat='大小 {0}'}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                  <TextBlock Text="{Binding LastModified, StringFormat='修改 {0:yyyy-MM-dd HH:mm}'}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </StackPanel>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Classes="empty-state" Margin="0,28,0,24" IsVisible="{Binding !HasWorlds}">
                      <TextBlock Text="暂无存档" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding SelectedResourceTabIndex, Converter={x:Static converters:TabIndexToBoolConverter.Instance}, ConverterParameter=1}">
                <StackPanel Margin="20,16,20,24" Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Mod" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="开关这个版本里已安装的 Mod" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" FontSize="12" Padding="12,5" Command="{Binding RefreshModsCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="刷新" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                        <Button Classes="ghost" FontSize="12" Padding="12,5" Command="{Binding OpenModsFolderCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="打开文件夹" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Mods}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource LayerFillColorPrimaryBrush}"
                                  CornerRadius="8"
                                  Padding="12"
                                  Margin="0,0,0,8"
                                  BorderThickness="1"
                                  BorderBrush="{Binding HasConflict, Converter={x:Static converters:BoolToBrushConverter.ConflictBorder}}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <Border Width="40" Height="40" CornerRadius="6" Margin="0,0,12,0"
                                      Background="{DynamicResource SurfaceBrush}"
                                      BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                                      ClipToBounds="True">
                                <Image Source="{Binding IconPath, Converter={x:Static converters:FilePathToBitmapConverter.Instance}}"
                                       Stretch="Uniform" Margin="4"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                  <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="4" Padding="6,1" IsVisible="{Binding HasConflict}">
                                    <TextBlock Text="冲突" FontSize="10" Foreground="{DynamicResource DangerBrush}" FontWeight="SemiBold"/>
                                  </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                  <TextBlock Text="{Binding ModId}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding ModId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                  <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding Version, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                  <TextBlock Text="{Binding Loader}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding Loader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ConflictDescription}" FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="{Binding HasConflict}"/>
                                <TextBlock Text="{Binding ConflictSuggestion}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" IsVisible="{Binding ConflictSuggestion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                              </StackPanel>
                              <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Classes="empty-state" Margin="0,28,0,24" IsVisible="{Binding !HasMods}">
                      <TextBlock Text="暂无 Mod" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding SelectedResourceTabIndex, Converter={x:Static converters:TabIndexToBoolConverter.Instance}, ConverterParameter=2}">
                <StackPanel Margin="20,16,20,24" Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="材质包" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="开关 resourcepacks 里的材质包" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" FontSize="12" Padding="12,5" Command="{Binding RefreshResourcePacksCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="刷新" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                        <Button Classes="ghost" FontSize="12" Padding="12,5" Command="{Binding OpenResourcePacksFolderCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="打开文件夹" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ResourcePacks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource LayerFillColorPrimaryBrush}"
                                  CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                  BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                              <Border Width="40" Height="40" CornerRadius="6" Margin="0,0,12,0"
                                      Background="{DynamicResource SurfaceBrush}"
                                      BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" ClipToBounds="True">
                                <Panel>
                                  <Path Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z"
                                        Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                  <Image Source="{Binding IconPath, Converter={x:Static converters:FilePathToBitmapConverter.Instance}}"
                                         Stretch="Uniform" Margin="4"/>
                                </Panel>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Size, StringFormat='{}{0:F0} KB'}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                              </StackPanel>
                              <Button Grid.Column="2" Classes="icon-ghost" Width="32" Height="32"
                                      Command="{Binding $parent[ItemsControl].((vm:InstanceViewModel)DataContext).DeleteResourcePackCommand}"
                                      CommandParameter="{Binding}" ToolTip.Tip="删除">
                                <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                      Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource DangerBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Button>
                              <ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled}" OnContent="" OffContent=""
                                            Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Classes="empty-state" Margin="0,28,0,24" IsVisible="{Binding !HasResourcePacks}">
                      <TextBlock Text="暂无材质包" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            IsVisible="{Binding SelectedResourceTabIndex, Converter={x:Static converters:TabIndexToBoolConverter.Instance}, ConverterParameter=3}">
                <StackPanel Margin="20,16,20,24" Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="光影" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="开关 shaderpacks 里的光影包" FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" FontSize="12" Padding="12,5" Command="{Binding RefreshShaderPacksCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="刷新" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                        <Button Classes="ghost" FontSize="12" Padding="12,5" Command="{Binding OpenShaderPacksFolderCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="M20 6H12L10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6M20 18H4V8H20V18Z" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="打开文件夹" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ShaderPacks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource LayerFillColorPrimaryBrush}"
                                  CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                  BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                              <Border Width="40" Height="40" CornerRadius="6" Margin="0,0,12,0"
                                      Background="{DynamicResource SurfaceBrush}"
                                      BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" ClipToBounds="True">
                                <Panel>
                                  <Path Data="M21 3H3C1.9 3 1 3.9 1 5V19C1 20.1 1.9 21 3 21H21C22.1 21 23 20.1 23 19V5C23 3.9 22.1 3 21 3M21 19H3V5H21V19M7.5 13.5L10 16.5L14 11.5L19 17H5L7.5 13.5Z"
                                        Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                  <Image Source="{Binding IconPath, Converter={x:Static converters:FilePathToBitmapConverter.Instance}}"
                                         Stretch="Uniform" Margin="4"/>
                                </Panel>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Size, StringFormat='{}{0:F0} KB'}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                              </StackPanel>
                              <Button Grid.Column="2" Classes="icon-ghost" Width="32" Height="32"
                                      Command="{Binding $parent[ItemsControl].((vm:InstanceViewModel)DataContext).DeleteShaderPackCommand}"
                                      CommandParameter="{Binding}" ToolTip.Tip="删除">
                                <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                      Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource DangerBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Button>
                              <ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled}" OnContent="" OffContent=""
                                            Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Classes="empty-state" Margin="0,28,0,24" IsVisible="{Binding !HasShaderPacks}">
                      <TextBlock Text="暂无光影" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Panel>
          </Grid>
        </ui:TabViewItem>


        <!-- ===== 导出整合包 ===== -->
        <ui:TabViewItem Header="导出" IsClosable="False">
          <ui:TabViewItem.IconSource>
            <ui:PathIconSource Data="M5 20H19V18H5M19 9H15V3H9V9H5L12 16L19 9Z"/>
          </ui:TabViewItem.IconSource>
          <views:ModpackExportPage DataContext="{Binding Export}"/>
        </ui:TabViewItem>
      </ui:TabView>

      <!-- 加载骨架屏 -->
      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Disabled"
                    IsVisible="{Binding IsLoading}">
        <StackPanel Margin="20" Spacing="14" MaxWidth="900" HorizontalAlignment="Stretch">
          <Border Classes="shimmer-line" Width="120" Height="14"/>

          <Grid ColumnDefinitions="*,*,*" Margin="0,4,0,0">
            <StackPanel Spacing="6">
              <Border Classes="shimmer-line" Width="56" Height="8"/>
              <Border Classes="shimmer-line" Width="96" Height="14"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Center">
              <Border Classes="shimmer-line" Width="56" Height="8"/>
              <Border Classes="shimmer-line" Width="72" Height="14"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right">
              <Border Classes="shimmer-line" Width="56" Height="8"/>
              <Border Classes="shimmer-line" Width="88" Height="14"/>
            </StackPanel>
          </Grid>

          <Separator Background="{DynamicResource DividerBrush}"/>

          <StackPanel Spacing="8">
            <Border Classes="shimmer-line" Width="72" Height="14"/>
            <Border Classes="shimmer" Padding="10,12" Height="44"/>
          </StackPanel>

          <Separator Background="{DynamicResource DividerBrush}"/>

          <StackPanel Spacing="8">
            <Border Classes="shimmer-line" Width="72" Height="14"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Classes="shimmer" Width="84" Height="30"/>
              <Border Classes="shimmer" Width="84" Height="30"/>
              <Border Classes="shimmer" Width="84" Height="30"/>
            </StackPanel>
          </StackPanel>

          <Separator Background="{DynamicResource DividerBrush}"/>

          <StackPanel Spacing="8">
            <Border Classes="shimmer-line" Width="72" Height="14"/>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
              <Border Classes="shimmer" Height="64"/>
              <Border Grid.Column="1" Classes="shimmer" Height="64"/>
              <Border Grid.Column="2" Classes="shimmer" Height="64"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    </Border>

    <!-- 分组管理弹窗：FluentAvalonia ContentDialog。
         用始终隐藏的 Panel 包住，避免视图显示时触发主题 :hidden 淡出动画导致弹窗闪现 -->
    <Panel IsVisible="False">
      <ui:ContentDialog x:Name="GroupManagerDialog"
                        Title="分组管理"
                        CloseButtonText="关闭">
        <StackPanel Spacing="8" Width="380">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding ManagedGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource SurfaceBrush}"
                          CornerRadius="8" Padding="12" Margin="0,0,0,6"
                          BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                              Background="{DynamicResource SurfaceElevatedBrush}"
                              IsVisible="{Binding IsSystem}"
                              VerticalAlignment="Center">
                        <TextBlock Text="系统组" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </Border>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                  IsVisible="{Binding IsDeletable}">
                        <Button Width="30" Height="30" Classes="icon-ghost" ToolTip.Tip="重命名"
                                Command="{Binding $parent[ItemsControl].((vm:InstanceViewModel)DataContext).RenameGroupCommand}"
                                CommandParameter="{Binding}">
                          <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Width="30" Height="30" Classes="icon-ghost" ToolTip.Tip="删除"
                                Command="{Binding $parent[ItemsControl].((vm:InstanceViewModel)DataContext).DeleteGroupCommand}"
                                CommandParameter="{Binding}">
                          <Path Data="M19 4H15.5L14.5 3H9.5L8.5 4H5V6H19M6 19A2 2 0 0 0 8 21H16A2 2 0 0 0 18 19V7H6V19Z"
                                Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource DangerBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <Grid ColumnDefinitions="*,Auto">
          <TextBox Watermark="输入新分组名称" Text="{Binding NewGroupName}" FontSize="13"/>
          <Button Grid.Column="1" Content="创建" Margin="8,0,0,0" Padding="14,0"
                  Command="{Binding CreateGroupCommand}"/>
        </Grid>
        </StackPanel>
      </ui:ContentDialog>
    </Panel>

  </Panel>
</UserControl>

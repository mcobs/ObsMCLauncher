<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:ObsMCLauncher.Desktop.Converters"
             xmlns:coremodels="using:ObsMCLauncher.Core.Models"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="ObsMCLauncher.Desktop.Views.CrashAnalysisPanel"
             x:DataType="coremodels:CrashAnalysisResult">

  <!-- 崩溃分析结果展示（结论 + 可能原因 + 可疑 Mod + 报告预览）。
       供「更多 → 崩溃分析」页与游戏崩溃提示窗口共用，改这里两边同时生效。
       排版：结论横条 → 元信息 chips → 原因卡片（证据 + InfoBar 建议条）→ 可疑 Mod chips
       → 报告预览（Expander 默认折叠）。文字徽标统一 Border.crash-chip（FA 的 InfoBadge
       放不了文字），数字徽标用 ui:InfoBadge；置信度颜色走 CrashConfidenceToBrushConverter。 -->
  <StackPanel>

    <!-- 结论横条：类别图标 + 主标题 + 来源 -->
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Border Classes="crash-icon-box" Background="{DynamicResource DangerSoftBrush}">
        <ui:SymbolIcon FontSize="17"
                       Foreground="{DynamicResource DangerBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Symbol="{Binding PrimaryCategory, Converter={x:Static converters:CrashCategoryToSymbolConverter.Instance}}"/>
      </Border>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="{Binding Headline}" FontSize="18" FontWeight="SemiBold"
                   TextWrapping="Wrap"/>
        <TextBlock Text="{Binding FileName, StringFormat='来源：{0}'}" FontSize="11"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </StackPanel>

    <!-- 元信息 chips（MC 版本 / 加载器 / Java / 崩溃时间） -->
    <WrapPanel Margin="0,10,0,0">
      <Border Classes="crash-chip" Margin="0,0,6,6"
              IsVisible="{Binding MinecraftVersion, Converter={x:Static converters:NotNullConverter.Instance}}">
        <TextBlock>
          <Run Text="MC "/><Run Text="{Binding MinecraftVersion}"/>
        </TextBlock>
      </Border>
      <Border Classes="crash-chip" Margin="0,0,6,6"
              IsVisible="{Binding LoaderInfo, Converter={x:Static converters:NotNullConverter.Instance}}">
        <TextBlock Text="{Binding LoaderInfo}"/>
      </Border>
      <Border Classes="crash-chip" Margin="0,0,6,6"
              IsVisible="{Binding JavaVersion, Converter={x:Static converters:NotNullConverter.Instance}}">
        <TextBlock>
          <Run Text="Java "/><Run Text="{Binding JavaVersion}"/>
        </TextBlock>
      </Border>
      <Border Classes="crash-chip" Margin="0,0,6,6"
              IsVisible="{Binding CrashTime, Converter={x:Static converters:NotNullConverter.Instance}}">
        <TextBlock Text="{Binding CrashTime}"/>
      </Border>
    </WrapPanel>

    <!-- 可能原因：标题 + 数量徽标 + 卡片列表 -->
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,8"
                IsVisible="{Binding Causes.Count, Converter={x:Static converters:GreaterThanZeroToIsVisibleConverter.Instance}}">
      <TextBlock Classes="crash-section-title" Text="可能原因" VerticalAlignment="Center"/>
      <ui:InfoBadge Value="{Binding Causes.Count}"
                    Background="{DynamicResource AccentBrush}" Foreground="White"/>
    </StackPanel>

    <ItemsControl ItemsSource="{Binding Causes}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="coremodels:CrashCause">
          <Border Classes="crash-cause-card" Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*">
              <Border Grid.Column="0" Classes="crash-icon-box"
                      Background="{Binding Confidence, Converter={x:Static converters:CrashConfidenceToBrushConverter.Instance}, ConverterParameter=soft}">
                <ui:SymbolIcon FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{Binding Confidence, Converter={x:Static converters:CrashConfidenceToBrushConverter.Instance}}"
                               Symbol="{Binding Category, Converter={x:Static converters:CrashCategoryToSymbolConverter.Instance}}"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6">
                <WrapPanel>
                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                             TextWrapping="Wrap" MaxWidth="520"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Border Classes="crash-chip" Margin="0,0,6,0">
                    <TextBlock Text="{Binding CategoryLabel}"/>
                  </Border>
                  <Border Classes="crash-chip"
                          Background="{Binding Confidence, Converter={x:Static converters:CrashConfidenceToBrushConverter.Instance}, ConverterParameter=soft}">
                    <TextBlock Text="{Binding ConfidenceLabel}" FontWeight="SemiBold"
                               Foreground="{Binding Confidence, Converter={x:Static converters:CrashConfidenceToBrushConverter.Instance}}"/>
                  </Border>
                </WrapPanel>

                <TextBlock Text="{Binding Evidence}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Evidence, Converter={x:Static converters:StringNotEmptyToBoolConverter.Instance}}"/>

                <!-- 修复建议：FA InfoBar 常驻显示，Severity 配色由 FA 主题管理（亮暗自适应） -->
                <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Success"
                            Message="{Binding Suggestion}" FontSize="12"
                            IsVisible="{Binding Suggestion, Converter={x:Static converters:StringNotEmptyToBoolConverter.Instance}}"/>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- 可疑 Mod -->
    <StackPanel Margin="0,8,0,0"
                IsVisible="{Binding SuspectedMods.Count, Converter={x:Static converters:GreaterThanZeroToIsVisibleConverter.Instance}}">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
        <TextBlock Classes="crash-section-title" Text="可疑 Mod" VerticalAlignment="Center"/>
        <ui:InfoBadge Value="{Binding SuspectedMods.Count}"
                      Background="{DynamicResource DangerBrush}" Foreground="White"/>
      </StackPanel>
      <ItemsControl ItemsSource="{Binding SuspectedMods}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <Border Classes="crash-chip crash-chip-danger" Margin="0,0,6,6">
              <TextBlock Text="{Binding}"/>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- 报告预览：默认折叠（原生 Expander，FA 2.4.1 无 Expander 类型） -->
    <Expander Margin="0,8,0,0" IsExpanded="False"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <Expander.Header>
        <TextBlock Classes="crash-section-title" Text="报告预览" VerticalAlignment="Center"/>
      </Expander.Header>
      <Border Background="{DynamicResource SurfaceElevatedBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="8" Padding="10" Margin="0,4,0,0">
        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
          <SelectableTextBlock Classes="crash-code" Text="{Binding RawPreview}"
                               TextWrapping="NoWrap"/>
        </ScrollViewer>
      </Border>
    </Expander>

  </StackPanel>
</UserControl>

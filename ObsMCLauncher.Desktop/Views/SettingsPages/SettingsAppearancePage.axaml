<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:converters="using:ObsMCLauncher.Desktop.Converters"
             x:Class="ObsMCLauncher.Desktop.Views.SettingsPages.SettingsAppearancePage"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12,16,12,24" Spacing="16">

      <TextBlock Text="外观设置" FontSize="22" FontWeight="SemiBold"/>

      <!-- 主题 -->
      <ui:SettingsExpander Header="主题" IsExpanded="True">
        <ui:SettingsExpanderItem Content="主题模式" Description="选择启动器的外观主题">
          <ui:SettingsExpanderItem.Footer>
            <ComboBox Width="160" SelectedIndex="{Binding ThemeMode}">
              <ComboBoxItem Content="深色模式"/>
              <ComboBoxItem Content="浅色模式"/>
              <ComboBoxItem Content="跟随系统"/>
            </ComboBox>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="强调色" Description="修改全局高亮配色（按钮、选中项、标签页）">
          <StackPanel Spacing="12">
            <!-- 预设色板 -->
            <ItemsControl ItemsSource="{Binding PresetAccentColors}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Margin="0,0,8,0" Padding="0" Width="28" Height="28" CornerRadius="50"
                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SetAccentColorCommand}"
                          CommandParameter="{Binding}">
                    <Button.Template>
                      <ControlTemplate>
                        <Border Width="28" Height="28" CornerRadius="50"
                                Background="{Binding}"
                                BorderBrush="{DynamicResource BorderBrush}">
                          <Border.BorderThickness>
                            <MultiBinding Converter="{x:Static converters:StringEqualsToThicknessConverter.Instance}">
                              <Binding Path="$parent[UserControl].((vm:SettingsViewModel)DataContext).AccentColor"/>
                              <Binding/>
                            </MultiBinding>
                          </Border.BorderThickness>
                        </Border>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 自定义取色：hex 输入 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Width="28" Height="28" CornerRadius="6" Background="{Binding AccentColorPreview}"/>
              <TextBox Width="150" Text="{Binding AccentColor, Mode=TwoWay}"
                       Watermark="#RRGGBB"
                       TextAlignment="Center"/>
              <TextBlock Text="按回车或失焦应用" FontSize="11"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ui:SettingsExpanderItem>
      </ui:SettingsExpander>

      <!-- 通知 -->
      <ui:SettingsExpander Header="通知" IsExpanded="True">
        <ui:SettingsExpanderItem Content="通知样式" Description="选择通知消息的显示位置和样式">
          <ui:SettingsExpanderItem.Footer>
            <StackPanel Orientation="Horizontal" Spacing="8">

              <!-- 居中通知预览（真实 InfoBar） -->
              <Border Width="220" CornerRadius="8"
                      BorderThickness="2"
                      BorderBrush="{Binding NotificationPosition, Converter={x:Static converters:NotificationPositionToBorderConverter.Instance}, ConverterParameter=Center}">
                <Button Classes="ghost" Padding="0"
                        Command="{Binding SelectCenterNotificationCommand}">
                  <StackPanel>
                    <Border Height="110" Padding="10"
                            CornerRadius="8,8,0,0"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                      <ui:InfoBar IsOpen="True" IsClosable="False"
                                  Severity="Informational"
                                  Title="通知标题"
                                  Message="通知内容"
                                  VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
                    </Border>
                    <Border Padding="8,6" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,8,8">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="居中显示" FontSize="11" FontWeight="Medium"/>
                        <TextBlock Text="窗口顶部居中" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Button>
              </Border>

              <!-- 右下角通知预览（真实 InfoBar） -->
              <Border Width="220" CornerRadius="8"
                      BorderThickness="2"
                      BorderBrush="{Binding NotificationPosition, Converter={x:Static converters:NotificationPositionToBorderConverter.Instance}, ConverterParameter=BottomRight}">
                <Button Classes="ghost" Padding="0"
                        Command="{Binding SelectBottomRightNotificationCommand}">
                  <StackPanel>
                    <Border Height="110" Padding="10"
                            CornerRadius="8,8,0,0"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                      <ui:InfoBar IsOpen="True" IsClosable="False"
                                  Severity="Success"
                                  Title="通知标题"
                                  Message="通知内容"
                                  Width="150"
                                  VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                    </Border>
                    <Border Padding="8,6" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,8,8">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="右下角显示" FontSize="11" FontWeight="Medium"/>
                        <TextBlock Text="窗口右下角" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Button>
              </Border>

            </StackPanel>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="自动关闭时间" Description="右下角通知自动关闭时间（3-30秒）"
                                 IsVisible="{Binding NotificationPosition, Converter={x:Static converters:NotificationPositionToVisibilityConverter.Instance}}">
          <ui:SettingsExpanderItem.Footer>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ui:NumberBox Value="{Binding NotificationAutoCloseSeconds}"
                            Minimum="3" Maximum="30" SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Width="140"/>
              <TextBlock Text="秒" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>
      </ui:SettingsExpander>

    </StackPanel>
  </ScrollViewer>

</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:converters="using:ObsMCLauncher.Desktop.Converters"
             x:Class="ObsMCLauncher.Desktop.Views.SettingsPages.SettingsAppearancePage"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12,16,12,24" Spacing="16">

      <TextBlock Text="外观设置" FontSize="22" FontWeight="SemiBold"/>

      <!-- 主题 -->
      <ui:SettingsExpander Header="主题" IsExpanded="True">
        <ui:SettingsExpanderItem Content="主题模式" Description="选择启动器的外观主题">
          <ui:SettingsExpanderItem.Footer>
            <ComboBox Width="160" SelectedIndex="{Binding ThemeMode}">
              <ComboBoxItem Content="深色模式"/>
              <ComboBoxItem Content="浅色模式"/>
              <ComboBoxItem Content="跟随系统"/>
            </ComboBox>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>
      </ui:SettingsExpander>

      <!-- 通知 -->
      <ui:SettingsExpander Header="通知" IsExpanded="True">
        <ui:SettingsExpanderItem Content="通知样式" Description="选择通知消息的显示位置和样式">
          <ui:SettingsExpanderItem.Footer>
            <StackPanel Orientation="Horizontal" Spacing="8">

              <!-- 居中通知预览 -->
              <Border Width="200" CornerRadius="8"
                      BorderThickness="2"
                      BorderBrush="{Binding NotificationPosition, Converter={x:Static converters:NotificationPositionToBorderConverter.Instance}, ConverterParameter=Center}">
                <Button Classes="ghost" Padding="0"
                        Command="{Binding SelectCenterNotificationCommand}">
                  <StackPanel>
                    <Border Height="120" CornerRadius="8,8,0,0" Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                      <Grid RowDefinitions="14,*">
                        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center" Spacing="3">
                              <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource PrimaryBrush}"/>
                              <TextBlock Text="ObsMCLauncher" FontSize="6" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="2" Width="14" Height="10" CornerRadius="0,4,0,0" Background="#30E81123"/>
                          </Grid>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="30,*">
                          <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BorderBrush}" Padding="5,5">
                            <StackPanel Spacing="4">
                              <Border Height="6" CornerRadius="3" Background="{DynamicResource PrimaryBrush}"/>
                              <Border Height="6" CornerRadius="3" Background="{DynamicResource SurfaceHoverBrush}"/>
                              <Border Height="6" CornerRadius="3" Background="{DynamicResource SurfaceHoverBrush}"/>
                              <Border Height="6" CornerRadius="3" Background="{DynamicResource SurfaceHoverBrush}"/>
                            </StackPanel>
                          </Border>
                          <Border Grid.Column="1" Background="{DynamicResource SystemControlBackgroundBaseHighBrush}" Padding="10,6">
                            <StackPanel Spacing="3">
                              <Border Height="6" Width="80" CornerRadius="3" Background="{DynamicResource TextTertiaryBrush}" Opacity="0.3"/>
                              <Border Height="4" Width="110" CornerRadius="2" Background="{DynamicResource TextTertiaryBrush}" Opacity="0.15"/>
                              <Border Height="4" Width="100" CornerRadius="2" Background="{DynamicResource TextTertiaryBrush}" Opacity="0.15"/>
                            </StackPanel>
                          </Border>
                        </Grid>
                        <Border Grid.Row="1" Grid.ColumnSpan="2"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Margin="0,8,0,0"
                                Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="6"
                                BorderThickness="1" BorderBrush="{DynamicResource PrimaryBrush}"
                                Padding="10,6" Width="120">
                          <StackPanel>
                            <Border Width="40" Height="4" CornerRadius="2" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left"/>
                            <Border Width="90" Height="3" CornerRadius="1.5" Background="{DynamicResource TextTertiaryBrush}" Opacity="0.4" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Border>
                    <Border Padding="8,6" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,8,8">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="居中显示" FontSize="11" FontWeight="Medium"/>
                        <TextBlock Text="窗口顶部居中" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Button>
              </Border>

              <!-- 右下角通知预览 -->
              <Border Width="200" CornerRadius="8"
                      BorderThickness="2"
                      BorderBrush="{Binding NotificationPosition, Converter={x:Static converters:NotificationPositionToBorderConverter.Instance}, ConverterParameter=BottomRight}">
                <Button Classes="ghost" Padding="0"
                        Command="{Binding SelectBottomRightNotificationCommand}">
                  <StackPanel>
                    <Border Height="120" CornerRadius="8,8,0,0" Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                      <Grid RowDefinitions="14,*">
                        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center" Spacing="3">
                              <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource PrimaryBrush}"/>
                              <TextBlock Text="ObsMCLauncher" FontSize="6" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="2" Width="14" Height="10" CornerRadius="0,4,0,0" Background="#30E81123"/>
                          </Grid>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="30,*">
                          <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BorderBrush}" Padding="5,5">
                            <StackPanel Spacing="4">
                              <Border Height="6" CornerRadius="3" Background="{DynamicResource PrimaryBrush}"/>
                              <Border Height="6" CornerRadius="3" Background="{DynamicResource SurfaceHoverBrush}"/>
                              <Border Height="6" CornerRadius="3" Background="{DynamicResource SurfaceHoverBrush}"/>
                              <Border Height="6" CornerRadius="3" Background="{DynamicResource SurfaceHoverBrush}"/>
                            </StackPanel>
                          </Border>
                          <Border Grid.Column="1" Background="{DynamicResource SystemControlBackgroundBaseHighBrush}" Padding="10,6">
                            <StackPanel Spacing="3">
                              <Border Height="6" Width="80" CornerRadius="3" Background="{DynamicResource TextTertiaryBrush}" Opacity="0.3"/>
                              <Border Height="4" Width="110" CornerRadius="2" Background="{DynamicResource TextTertiaryBrush}" Opacity="0.15"/>
                              <Border Height="4" Width="100" CornerRadius="2" Background="{DynamicResource TextTertiaryBrush}" Opacity="0.15"/>
                            </StackPanel>
                          </Border>
                        </Grid>
                        <Border Grid.Row="1" Grid.ColumnSpan="2"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,6,6"
                                Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="6"
                                BorderThickness="1" BorderBrush="{DynamicResource PrimaryBrush}"
                                Padding="10,6" Width="120">
                          <StackPanel>
                            <Border Width="40" Height="4" CornerRadius="2" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left"/>
                            <Border Width="90" Height="3" CornerRadius="1.5" Background="{DynamicResource TextTertiaryBrush}" Opacity="0.4" Margin="0,4,0,0" HorizontalAlignment="Left"/>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Border>
                    <Border Padding="8,6" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,8,8">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="右下角显示" FontSize="11" FontWeight="Medium"/>
                        <TextBlock Text="窗口右下角" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Button>
              </Border>

            </StackPanel>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="自动关闭时间" Description="右下角通知自动关闭时间（3-30秒）"
                                 IsVisible="{Binding NotificationPosition, Converter={x:Static converters:NotificationPositionToVisibilityConverter.Instance}}">
          <ui:SettingsExpanderItem.Footer>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBox Text="{Binding NotificationAutoCloseSeconds}" Width="60" HorizontalContentAlignment="Right"/>
              <TextBlock Text="秒" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>
      </ui:SettingsExpander>

    </StackPanel>
  </ScrollViewer>

</UserControl>

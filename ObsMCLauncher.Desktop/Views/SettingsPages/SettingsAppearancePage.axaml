<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:converters="using:ObsMCLauncher.Desktop.Converters"
             xmlns:a="using:Avalonia.Media"
             x:Class="ObsMCLauncher.Desktop.Views.SettingsPages.SettingsAppearancePage"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12,16,12,24" Spacing="16">

      <TextBlock Text="外观设置" FontSize="22" FontWeight="SemiBold"/>

      <!-- 主题 -->
      <ui:SettingsExpander Header="主题" IsExpanded="True">
        <ui:SettingsExpanderItem Content="主题模式" Description="选择启动器的外观主题">
          <ui:SettingsExpanderItem.Footer>
            <ComboBox Width="160" SelectedIndex="{Binding ThemeMode}">
              <ComboBoxItem Content="深色模式"/>
              <ComboBoxItem Content="浅色模式"/>
              <ComboBoxItem Content="跟随系统"/>
            </ComboBox>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="强调色" Description="应用显示强调元素时所使用的全局高亮配色">
          <ui:SettingsExpanderItem.Footer>
            <ColorPicker Color="{Binding AccentColorValue, Mode=TwoWay}"/>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>
      </ui:SettingsExpander>

      <!-- 个性：圆角 / 密度 / 动画 -->
      <ui:SettingsExpander Header="个性" IsExpanded="True" Description="调整界面的观感细节">
        <ui:SettingsExpanderItem Content="圆角半径" Description="控制主要容器与卡片的圆角大小">
          <ui:SettingsExpanderItem.Footer>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Slider Width="160" Minimum="0" Maximum="28" TickFrequency="1"
                      IsSnapToTickEnabled="True"
                      Value="{Binding CornerRadius, Mode=TwoWay}"/>
              <TextBlock Text="{Binding CornerRadius}" FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="密度" Description="控制主要界面的留白与间距">
          <ui:SettingsExpanderItem.Footer>
            <ComboBox Width="140" SelectedIndex="{Binding Density}">
              <ComboBoxItem Content="紧凑"/>
              <ComboBoxItem Content="标准"/>
              <ComboBoxItem Content="宽松"/>
            </ComboBox>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="动画级别" Description="控制主要过渡动画的启用与强度">
          <ui:SettingsExpanderItem.Footer>
            <ComboBox Width="140" SelectedIndex="{Binding AnimationLevel}">
              <ComboBoxItem Content="禁用"/>
              <ComboBoxItem Content="标准"/>
              <ComboBoxItem Content="华丽"/>
            </ComboBox>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>
      </ui:SettingsExpander>

      <!-- 字体 -->
      <ui:SettingsExpander Header="字体" IsExpanded="True" Description="自定义启动器界面显示的字体">
        <ui:SettingsExpanderItem Content="自定义字体" Description="界面文字使用的字体，下拉列表按字体本身预览">
          <ui:SettingsExpanderItem.Footer>
            <ComboBox Width="220" MaxDropDownHeight="360"
                      ItemsSource="{Binding FontFamilies}"
                      SelectedItem="{Binding SelectedFontItem, Mode=TwoWay}"
                      HorizontalAlignment="Left">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FontFamilyItem">
                  <TextBlock Text="{Binding Display}" FontFamily="{Binding Family}"
                             ToolTip.Tip="{Binding Display}"
                             MaxWidth="200" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="自定义字重" Description="界面文字的粗细，需要所选字体支持对应字重">
          <ui:SettingsExpanderItem.Footer>
            <ComboBox Width="150"
                      ItemsSource="{x:Static vm:SettingsViewModel.FontWeightOptions}"
                      SelectedItem="{Binding SelectedFontWeight, Mode=TwoWay}"
                      HorizontalAlignment="Left">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="a:FontWeight">
                  <TextBlock Text="{Binding}" FontWeight="{Binding}" ToolTip.Tip="{Binding}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>
      </ui:SettingsExpander>

      <!-- 背景壁纸 -->
      <ui:SettingsExpander Header="背景壁纸" IsExpanded="True" Description="为启动器主界面设置本地壁纸">
        <ui:SettingsExpanderItem Content="启用壁纸" Description="在主内容区显示背景图片">
          <ui:SettingsExpanderItem.Footer>
            <ToggleSwitch IsChecked="{Binding WallpaperEnabled, Mode=TwoWay}"/>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="选择图片" Description="选择本地图片作为壁纸">
          <ui:SettingsExpanderItem.Footer>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="浏览…" Command="{Binding BrowseWallpaperCommand}"/>
              <TextBlock Text="{Binding WallpaperPath}" FontSize="11" MaxWidth="200"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="不透明度" Description="壁纸的透明程度">
          <ui:SettingsExpanderItem.Footer>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Slider Width="160" Minimum="0" Maximum="1" TickFrequency="0.05"
                      IsSnapToTickEnabled="True"
                      Value="{Binding WallpaperOpacity, Mode=TwoWay}"/>
              <TextBlock Text="{Binding WallpaperOpacity, StringFormat={}{0:P0}}" FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="显示方式" Description="壁纸的拉伸方式">
          <ui:SettingsExpanderItem.Footer>
            <ComboBox Width="140" SelectedIndex="{Binding WallpaperStretch}">
              <ComboBoxItem Content="拉伸填充"/>
              <ComboBoxItem Content="适应缩放"/>
              <ComboBoxItem Content="裁剪填充"/>
              <ComboBoxItem Content="原始大小"/>
            </ComboBox>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="扩展到导航栏" Description="将壁纸延伸到左侧导航栏区域">
          <ui:SettingsExpanderItem.Footer>
            <ToggleSwitch IsChecked="{Binding WallpaperExtendToNav, Mode=TwoWay}"/>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="导航栏透明度" Description="扩展到导航栏时，导航栏背景的透明程度">
          <ui:SettingsExpanderItem.Footer>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Slider Width="160" Minimum="0.1" Maximum="1" TickFrequency="0.05"
                      IsSnapToTickEnabled="True"
                      Value="{Binding NavBackgroundOpacity, Mode=TwoWay}"/>
              <TextBlock Text="{Binding NavBackgroundOpacity, StringFormat={}{0:P0}}" FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>
      </ui:SettingsExpander>

      <!-- 通知 -->
      <ui:SettingsExpander Header="通知" IsExpanded="True">
        <ui:SettingsExpanderItem Content="通知样式" Description="选择通知消息的显示位置和样式">
          <ui:SettingsExpanderItem.Footer>
            <StackPanel Orientation="Horizontal" Spacing="8">

              <!-- 居中通知预览（真实 InfoBar） -->
              <Border Width="220" CornerRadius="8"
                      BorderThickness="2"
                      BorderBrush="{Binding NotificationPosition, Converter={x:Static converters:NotificationPositionToBorderConverter.Instance}, ConverterParameter=Center}">
                <Button Classes="ghost" Padding="0"
                        Command="{Binding SelectCenterNotificationCommand}">
                  <StackPanel>
                    <Border Height="110" Padding="10"
                            CornerRadius="8,8,0,0"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                      <ui:InfoBar IsOpen="True" IsClosable="False"
                                  Severity="Informational"
                                  Title="通知标题"
                                  Message="通知内容"
                                  VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
                    </Border>
                    <Border Padding="8,6" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,8,8">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="居中显示" FontSize="11" FontWeight="Medium"/>
                        <TextBlock Text="窗口顶部居中" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Button>
              </Border>

              <!-- 右下角通知预览（真实 InfoBar） -->
              <Border Width="220" CornerRadius="8"
                      BorderThickness="2"
                      BorderBrush="{Binding NotificationPosition, Converter={x:Static converters:NotificationPositionToBorderConverter.Instance}, ConverterParameter=BottomRight}">
                <Button Classes="ghost" Padding="0"
                        Command="{Binding SelectBottomRightNotificationCommand}">
                  <StackPanel>
                    <Border Height="110" Padding="10"
                            CornerRadius="8,8,0,0"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                      <ui:InfoBar IsOpen="True" IsClosable="False"
                                  Severity="Success"
                                  Title="通知标题"
                                  Message="通知内容"
                                  Width="150"
                                  VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                    </Border>
                    <Border Padding="8,6" Background="{DynamicResource SurfaceBrush}" CornerRadius="0,0,8,8">
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="右下角显示" FontSize="11" FontWeight="Medium"/>
                        <TextBlock Text="窗口右下角" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Button>
              </Border>

            </StackPanel>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="自动关闭时间" Description="右下角通知自动关闭时间（3-30秒）"
                                 IsVisible="{Binding NotificationPosition, Converter={x:Static converters:NotificationPositionToVisibilityConverter.Instance}}">
          <ui:SettingsExpanderItem.Footer>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ui:NumberBox Value="{Binding NotificationAutoCloseSeconds}"
                            Minimum="3" Maximum="30" SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Width="140"/>
              <TextBlock Text="秒" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>
      </ui:SettingsExpander>

    </StackPanel>
  </ScrollViewer>

</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:converters="using:ObsMCLauncher.Desktop.Converters"
             x:Class="ObsMCLauncher.Desktop.Views.SettingsPages.SettingsGamePage"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12,16,12,24" Spacing="16">

      <TextBlock Text="游戏设置" FontSize="22" FontWeight="SemiBold"/>

      <!-- 运行环境 -->
      <ui:SettingsExpander Header="运行环境" IsExpanded="True">
        <ui:SettingsExpanderItem Content="Java 路径" Description="选择游戏启动所使用的 Java 运行时">
          <ui:SettingsExpanderItem.Footer>
            <StackPanel Spacing="8" Width="380">
              <ComboBox ItemsSource="{Binding JavaOptions}" SelectedItem="{Binding SelectedJavaOption}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                      <TextBlock Grid.Column="0" Text="{Binding Display}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center"
                                 IsVisible="{Binding IsPathVisible}"
                                 Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"
                                 TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCustomJava}">
                <TextBox Grid.Column="0" Text="{Binding CustomJavaPath}" Watermark="自定义Java路径" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="浏览" Width="72" Command="{Binding BrowseJavaPathCommand}"/>
              </Grid>
            </StackPanel>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="最大内存分配" Description="最小内存固定为 512MB">
          <ui:SettingsExpanderItem.Footer>
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Slider Minimum="1024" Maximum="65536" Value="{Binding MaxMemory}" Width="220"/>
                <TextBox Text="{Binding MaxMemory}" Width="70" HorizontalContentAlignment="Right" Watermark="MB"/>
                <TextBlock Text="MB" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <TextBlock Text="{Binding MemoryHint}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         IsVisible="{Binding !IsMemoryHintWarning}"/>
              <TextBlock Text="{Binding MemoryHint}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource WarningBrush}"
                         IsVisible="{Binding IsMemoryHintWarning}"/>
            </StackPanel>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="版本隔离" Description="开启后，每个版本将使用独立的 mods、saves、resourcepacks 等文件夹">
          <ui:SettingsExpanderItem.Footer>
            <ComboBox ItemsSource="{Binding GameDirectoryTypeOptions}" SelectedItem="{Binding GameDirectoryType}" Width="200">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={x:Static converters:EnumToChineseTextConverter.Instance}}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>
      </ui:SettingsExpander>

      <!-- 启动选项 -->
      <ui:SettingsExpander Header="启动选项" IsExpanded="True">
        <ui:SettingsExpanderItem Content="游戏启动后关闭启动器" Description="减少内存占用">
          <ui:SettingsExpanderItem.Footer>
            <ToggleSwitch IsChecked="{Binding CloseAfterLaunch}"/>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="JVM 参数" Description="自定义游戏启动参数（高级选项）">
          <ui:SettingsExpanderItem.Footer>
            <TextBox Text="{Binding JvmArguments}" AcceptsReturn="True" TextWrapping="Wrap"
                     Width="360" MinHeight="60" MaxHeight="140" Watermark="-Xmx2G -XX:+UseG1GC"/>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>
      </ui:SettingsExpander>

    </StackPanel>
  </ScrollViewer>

</UserControl>

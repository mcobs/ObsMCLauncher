<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:converters="using:ObsMCLauncher.Desktop.Converters"
             x:Class="ObsMCLauncher.Desktop.Views.SettingsPages.SettingsDownloadPage"
             x:DataType="vm:SettingsViewModel">

  <!--
    下载设置。

    与 SettingsAppearancePage 同一套视觉语言：参数行一律 ui:SettingsExpanderItem，
    Content 是行标题、Description 是副标题、Footer 是右侧控件槽、IconSource 是行首图标。
    不再使用手写的 settings-card / settings-row / settings-divider。
  -->

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12,16,12,24" Spacing="16">

      <TextBlock Text="下载设置" FontSize="22" FontWeight="SemiBold"/>

      <!-- ===== 下载源 ===== -->
      <ui:SettingsExpander Header="下载源" IsExpanded="True">
        <ui:SettingsExpander.IconSource>
          <ui:SymbolIconSource Symbol="Cloud"/>
        </ui:SettingsExpander.IconSource>

        <ui:SettingsExpanderItem Content="下载源"
                                 Description="{Binding DownloadSourceDescription, Mode=OneWay}">
          <ui:SettingsExpanderItem.IconSource>
            <ui:SymbolIconSource Symbol="Globe"/>
          </ui:SettingsExpanderItem.IconSource>
          <ui:SettingsExpanderItem.Footer>
            <ComboBox Width="220"
                      ItemsSource="{Binding DownloadSourceOptions}"
                      SelectedItem="{Binding DownloadSource, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="社区镜像源"
                                 Description="{Binding MirrorSourceModeDescription, Mode=OneWay}">
          <ui:SettingsExpanderItem.IconSource>
            <ui:SymbolIconSource Symbol="CloudSync"/>
          </ui:SettingsExpanderItem.IconSource>
          <ui:SettingsExpanderItem.Footer>
            <ComboBox Width="220"
                      ItemsSource="{Binding MirrorSourceModeOptions}"
                      SelectedItem="{Binding MirrorSourceMode, Mode=TwoWay}"
                      VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={x:Static converters:EnumToChineseTextConverter.Instance}}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>
      </ui:SettingsExpander>

      <!-- ===== 下载选项 ===== -->
      <ui:SettingsExpander Header="下载选项" IsExpanded="True">
        <ui:SettingsExpander.IconSource>
          <ui:SymbolIconSource Symbol="Download"/>
        </ui:SettingsExpander.IconSource>

        <ui:SettingsExpanderItem Content="最大下载线程"
                                 Description="同时下载的文件数量">
          <ui:SettingsExpanderItem.IconSource>
            <ui:SymbolIconSource Symbol="TwoPage"/>
          </ui:SettingsExpanderItem.IconSource>
          <ui:SettingsExpanderItem.Footer>
            <ComboBox Width="120"
                      ItemsSource="{Binding MaxDownloadThreadsOptions}"
                      SelectedItem="{Binding MaxDownloadThreads, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>

        <ui:SettingsExpanderItem Content="下载游戏时完整下载所有资源文件"
                                 Description="下载游戏依赖库、声音、语言、纹理等全部资源文件">
          <ui:SettingsExpanderItem.IconSource>
            <ui:SymbolIconSource Symbol="SelectAll"/>
          </ui:SettingsExpanderItem.IconSource>
          <ui:SettingsExpanderItem.Footer>
            <ToggleSwitch IsChecked="{Binding DownloadAssetsWithGame, Mode=TwoWay}"
                          OnContent="" OffContent="" VerticalAlignment="Center"/>
          </ui:SettingsExpanderItem.Footer>
        </ui:SettingsExpanderItem>
      </ui:SettingsExpander>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="测试下载源" Command="{Binding TestDownloadSourceCommand}"/>
        <Button Content="恢复默认设置" Command="{Binding ResetDefaultsCommand}"/>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>

</UserControl>

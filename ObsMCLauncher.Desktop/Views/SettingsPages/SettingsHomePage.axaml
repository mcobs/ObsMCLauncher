<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:views="using:ObsMCLauncher.Desktop.Views"
             xmlns:converters="using:ObsMCLauncher.Desktop.Converters"
             x:Class="ObsMCLauncher.Desktop.Views.SettingsPages.SettingsHomePage"
             x:DataType="vm:SettingsHomeViewModel">

  <UserControl.Resources>
    <converters:CardIconConverter x:Key="CardIconConverter"/>

    <!-- 编辑器中的组件外壳：包裹真实组件渲染 + 选中态 + 删除按钮 -->
    <DataTemplate x:Key="EditableComponentTemplate" x:DataType="vm:HomeComponentViewModel">
      <Border Classes="edit-comp"
              Padding="3"
              PointerPressed="ComponentChrome_PointerPressed">
        <Panel>
          <!-- 组件真实渲染（模板来自 App 级），预览中不响应交互 -->
          <ContentPresenter Content="{Binding}" IsHitTestVisible="False"/>
          <!-- 透明覆盖层：拦截命中与光标，避免内部组件的光标/交互泄漏导致闪烁与误触 -->
          <Border Background="Transparent" Cursor="Hand"/>
          <!-- 选中态虚线框 -->
          <Border Classes="edit-comp-selection"
                  IsVisible="{Binding IsEditorSelected}"
                  IsHitTestVisible="False"/>
          <!-- 选中后右上角直接删除 -->
          <Button Classes="edit-comp-del"
                  IsVisible="{Binding IsEditorSelected}"
                  Click="ComponentDelete_Click"
                  ToolTip.Tip="删除组件">
            <Path Data="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12L19 6.41Z"
                  Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource TextBrush}"/>
          </Button>
        </Panel>
      </Border>
    </DataTemplate>

    <!-- 编辑器中的行：行首删除按钮 + 组件容器 + 空行占位 + 拖拽落点高亮 -->
    <DataTemplate x:Key="EditableRowTemplate" x:DataType="vm:HomeRowViewModel">
      <Grid Classes="edit-row-root" ColumnDefinitions="Auto,*" Margin="0,0,0,16" MinHeight="44">
        <!-- 行首删除按钮（悬停行时显示） -->
        <Border Grid.Column="0" Classes="edit-row-toolbar" VerticalAlignment="Center" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="edit-tool-btn" Click="RowDelete_Click" ToolTip.Tip="删除此行">
              <Path Data="M19 4H15.5L14.5 3H9.5L8.5 4H5V6H19M6 19C6 20.1 6.9 21 8 21H16C17.1 21 18 20.1 18 19V7H6V19Z"
                    Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource TextBrush}"/>
            </Button>
          </StackPanel>
        </Border>

        <!-- 组件区域 -->
        <Panel Grid.Column="1">
          <!-- 空行占位：保证新建的行看得见、可悬停出工具条 -->
          <Border Classes="edit-row-empty" IsVisible="{Binding IsEmpty}" MinHeight="44">
            <TextBlock Text="空行：拖拽组件到这里"
                       FontSize="12"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <!-- 常规行：一排到底，放不下时按宽度等比缩小（与真实主页一致） -->
          <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"
                   IsVisible="{Binding !IsSingleFill}">
            <ItemsControl ItemsSource="{Binding Components}" MinHeight="44">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <StaticResource ResourceKey="EditableComponentTemplate"/>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Viewbox>

          <!-- 单个 Fill 组件独占整行 -->
          <ItemsControl ItemsSource="{Binding Components}" IsVisible="{Binding IsSingleFill}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Grid/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <StaticResource ResourceKey="EditableComponentTemplate"/>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 拖拽落点高亮 -->
          <Border Classes="edit-row-drop" IsVisible="{Binding IsDropTarget}" IsHitTestVisible="False"/>
        </Panel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.edit-comp">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.edit-comp:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentSecondaryBrush}"/>
    </Style>
    <Style Selector="Border.edit-comp-selection">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Margin" Value="-3"/>
      <Setter Property="Background" Value="#1410B981"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <!-- 选中组件右上角的删除按钮 -->
    <Style Selector="Button.edit-comp-del">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Margin" Value="0,-8,-8,0"/>
      <Setter Property="Background" Value="{DynamicResource LayerFillColorPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="ZIndex" Value="10"/>
    </Style>
    <Style Selector="Button.edit-comp-del:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentFillAttentionBrush}"/>
    </Style>
    <!-- 空行占位 -->
    <Style Selector="Border.edit-row-empty">
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{DynamicResource LayerFillColorPrimaryBrush}"/>
      <Setter Property="Opacity" Value="0.7"/>
    </Style>
    <!-- 拖拽落点高亮 -->
    <Style Selector="Border.edit-row-drop">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="#1410B981"/>
    </Style>
    <Style Selector="Border.edit-row-toolbar">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource LayerFillColorPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="2"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <!-- 悬停行任意位置时显示行工具条 -->
    <Style Selector="Grid.edit-row-root:pointerover > Border.edit-row-toolbar">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button.edit-tool-btn">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.edit-tool-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>
    <!-- 拖拽跟随光标的浮层 -->
    <Style Selector="Border.drag-ghost">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Opacity" Value="0.92"/>
      <Setter Property="BoxShadow" Value="0 4 16 0 #40000000"/>
    </Style>
    <Style Selector="Border.add-row-slot">
      <Setter Property="Margin" Value="24,0,24,16"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="#0CFFFFFF"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.add-row-slot:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Background" Value="#1410B981"/>
    </Style>
    <Style Selector="Button.add-row-btn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.add-row-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>
    <!-- 组件库条目 -->
    <Style Selector="Border.lib-chip">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
      <Setter Property="Background" Value="{DynamicResource LayerFillColorPrimaryBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.lib-chip:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
      <Setter Property="RenderTransform" Value="translateY(-1px)"/>
    </Style>
  </UserControl.Styles>

  <Grid x:Name="PageRoot">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="12,16,12,24" Spacing="14">

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="主页自定义" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="恢复默认布局" Classes="ghost"
                  Command="{Binding ResetLayoutCommand}" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Text="在预览中点击选中组件（右上角可删除），从下方组件库点击或拖入组件；改动实时保存并同步到主页。每行宽度有上限，放不下时会整行等比缩小。"
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

        <!-- 模拟主页：固定设计尺寸与真实主页内容区同比例，等比缩放显示（窗口最大化也不超过设计尺寸） -->
        <Viewbox Stretch="Uniform" MaxWidth="880" MaxHeight="600" HorizontalAlignment="Center">
          <Border x:Name="PreviewRoot" Width="880" Height="600"
                  BorderBrush="{DynamicResource CardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource CardCornerRadius}"
                  Background="{DynamicResource LayerFillColorSecondaryBrush}"
                  ClipToBounds="True">
            <Grid RowDefinitions="*,Auto">
              <ScrollViewer x:Name="PreviewScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                               ScrollChanged="PreviewScroll_ScrollChanged">
                  <StackPanel>
                    <ItemsControl ItemsSource="{Binding Home.HomeRows}" Margin="24,24,24,16"
                                  ItemTemplate="{StaticResource EditableRowTemplate}"/>

                    <!-- 添加行槽位：位于最后一行之后、垂直居中显示一个加号；滚动到底部时隐藏 -->
                    <Border x:Name="AddRowSlot" Classes="add-row-slot">
                      <Button Classes="add-row-btn" Click="AddRow_Click" ToolTip.Tip="添加一行">
                        <Path Data="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                              Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource AccentBrush}"/>
                      </Button>
                    </Border>
                  </StackPanel>
                </ScrollViewer>

                <!-- 固定操作区：与真实主页共用同一控件，仅作预览不响应交互 -->
                <views:HomeActionBar Grid.Row="1" DataContext="{Binding Home}" IsHitTestVisible="False"/>
              </Grid>
            </Border>
          </Viewbox>

        <!-- 选中组件操作条 -->
        <Border Classes="settings-card" IsVisible="{Binding HasSelectedComponent}" Padding="14">
          <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
              <TextBlock FontSize="13" FontWeight="Medium">
                <Run Text="已选中："/>
                <Run Text="{Binding SelectedComponentTitle}"/>
              </TextBlock>
              <TextBlock Text="拖拽可移动位置，删除后可从组件库重新添加"
                         FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="尺寸" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <ComboBox Width="110"
                        ItemsSource="{x:Static vm:SettingsHomeViewModel.SizeOptionNames}"
                        SelectedIndex="{Binding SelectedComponentSizeIndex}"/>
            </StackPanel>
            <Button Grid.Column="2" Content="删除组件" Classes="ghost" Click="DeleteSelected_Click" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <!-- 组件库 -->
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:SymbolIcon Symbol="Library" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="组件库" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="点击或拖拽到上方预览中添加，同一组件可添加多个" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
          </StackPanel>

          <ItemsControl ItemsSource="{Binding LibraryGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LibraryGroupViewModel">
                <StackPanel Margin="0,0,0,10" Spacing="6">
                  <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LibraryComponentItem">
                        <Border Classes="lib-chip" Margin="0,0,8,8"
                                PointerPressed="LibraryChip_PointerPressed"
                                ToolTip.Tip="{Binding Description}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                              <Path Data="{Binding Descriptor.Icon, Converter={StaticResource CardIconConverter}}"
                                    IsVisible="{Binding Descriptor.Icon, Converter={StaticResource CardIconConverter}, ConverterParameter=IsPath}"
                                    Fill="{DynamicResource AccentBrush}"
                                    Width="16" Height="16" Stretch="Uniform"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding Descriptor.Icon}"
                                         IsVisible="{Binding Descriptor.Icon, Converter={StaticResource CardIconConverter}, ConverterParameter=IsText}"
                                         FontSize="16"
                                         Foreground="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"/>
                              <TextBlock Text="{Binding Description}" FontSize="10"
                                         Foreground="{DynamicResource TextSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- 拖拽时跟随光标的提示浮层 -->
    <Border x:Name="DragGhost" Classes="drag-ghost"
            IsVisible="False" IsHitTestVisible="False"
            HorizontalAlignment="Left" VerticalAlignment="Top">
      <TextBlock x:Name="DragGhostText" FontSize="12" FontWeight="Medium"/>
    </Border>
  </Grid>
</UserControl>

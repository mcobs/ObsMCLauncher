<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:views="using:ObsMCLauncher.Desktop.Views"
             x:Class="ObsMCLauncher.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <!-- 组件渲染模板定义在 App.axaml（Application.DataTemplates），与设置页模拟主页共用 -->

  <!-- 布局渲染：卡片区独立滚动 + 固定操作区；行内组件一排到底，超宽时整行等比缩小不换行
       实例页打开时主页内容整体收起（IsVisible=false）：
       实例页背景是透明的（透出壁纸），若主页内容还留在视觉树里就会透过实例页显形，
       看起来像"主页上蒙了层纱"。收起后实例页透出的就只有壁纸，与主页空白区域一致。 -->
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                  IsVisible="{Binding !InstanceViewModel.IsVisible}">
      <ItemsControl ItemsSource="{Binding HomeRows}" Margin="24,24,24,16">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HomeRowViewModel">
            <Panel Margin="0,0,0,16">
              <!-- 常规行：一排到底，放不下时按宽度等比缩小 -->
              <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"
                       IsVisible="{Binding !IsSingleFill}">
                <ItemsControl ItemsSource="{Binding Components}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </Viewbox>
              <!-- 单个 Fill 组件独占整行 -->
              <ItemsControl ItemsSource="{Binding Components}" IsVisible="{Binding IsSingleFill}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Grid/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <views:HomeActionBar Grid.Row="1" IsVisible="{Binding !InstanceViewModel.IsVisible}"/>

    <views:InstanceView Grid.RowSpan="2" DataContext="{Binding InstanceViewModel}"/>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:views="using:ObsMCLauncher.Desktop.Views"
             x:Class="ObsMCLauncher.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <!-- 组件渲染模板定义在 App.axaml（Application.DataTemplates），与设置页模拟主页共用 -->

  <!-- 布局渲染：滚动区（普通行）+ 底部固定区（固定行），行内组件横向排列自动换行 -->
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding ScrollableRows}" Margin="24,24,24,16">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HomeRowViewModel">
            <Panel Margin="0,0,0,16">
              <!-- 常规行：组件横向排列自动换行 -->
              <ItemsControl ItemsSource="{Binding Components}" IsVisible="{Binding !IsSingleFill}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <!-- 单个 Fill 组件独占整行 -->
              <ItemsControl ItemsSource="{Binding Components}" IsVisible="{Binding IsSingleFill}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Grid/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Margin="24,0,24,16">
      <ItemsControl ItemsSource="{Binding PinnedRows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HomeRowViewModel">
            <Panel Margin="0,0,0,12">
              <ItemsControl ItemsSource="{Binding Components}" IsVisible="{Binding !IsSingleFill}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Components}" IsVisible="{Binding IsSingleFill}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Grid/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <views:InstanceView Grid.RowSpan="2" DataContext="{Binding InstanceViewModel}"/>
  </Grid>
</UserControl>

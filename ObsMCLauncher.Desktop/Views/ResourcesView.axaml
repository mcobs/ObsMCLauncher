<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
             xmlns:converters="using:ObsMCLauncher.Desktop.Converters"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="ObsMCLauncher.Desktop.Views.ResourcesView"
             x:DataType="vm:ResourcesViewModel"
             x:Name="Root">

  <UserControl.Styles>
    <!-- 结果列表：移除 ListBoxItem 选中/悬浮视觉，条目自身为卡片 -->
    <Style Selector="ListBox.results-list ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.results-list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.results-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 结果条目卡片 -->
    <Style Selector="Border.resource-row">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CircularEaseOut" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" Easing="CircularEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.resource-row:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20">

    <!-- 页头 -->
    <StackPanel Grid.Row="0" Spacing="4" IsVisible="{Binding IsListVisible}">
      <TextBlock Text="资源中心" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="下载 MOD、材质包、光影、数据包和整合包" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />
    </StackPanel>

    <!-- 工具栏 -->
    <StackPanel Grid.Row="1" Margin="0,0,0,14" Spacing="8" IsVisible="{Binding IsListVisible}">

      <Grid ColumnDefinitions="Auto,*">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
          <RadioButton Classes="segment" Content="MOD" GroupName="resType"
                       IsChecked="{Binding CurrentResourceType, Converter={x:Static converters:StringEqualsConverter.Instance}, ConverterParameter=Mods}"
                       Command="{Binding ChangeTypeCommand}" CommandParameter="Mods" />
          <RadioButton Classes="segment" Content="材质包" GroupName="resType"
                       IsChecked="{Binding CurrentResourceType, Converter={x:Static converters:StringEqualsConverter.Instance}, ConverterParameter=Textures}"
                       Command="{Binding ChangeTypeCommand}" CommandParameter="Textures" />
          <RadioButton Classes="segment" Content="光影" GroupName="resType"
                       IsChecked="{Binding CurrentResourceType, Converter={x:Static converters:StringEqualsConverter.Instance}, ConverterParameter=Shaders}"
                       Command="{Binding ChangeTypeCommand}" CommandParameter="Shaders" />
          <RadioButton Classes="segment" Content="数据包" GroupName="resType"
                       IsChecked="{Binding CurrentResourceType, Converter={x:Static converters:StringEqualsConverter.Instance}, ConverterParameter=Datapacks}"
                       Command="{Binding ChangeTypeCommand}" CommandParameter="Datapacks" />
          <RadioButton Classes="segment" Content="整合包" GroupName="resType"
                       IsChecked="{Binding CurrentResourceType, Converter={x:Static converters:StringEqualsConverter.Instance}, ConverterParameter=Modpacks}"
                       Command="{Binding ChangeTypeCommand}" CommandParameter="Modpacks" />
        </StackPanel>

        <TextBox Grid.Column="1" Text="{Binding Query}" Watermark="搜索资源名称、作者或中文名"
                 VerticalContentAlignment="Center">
          <TextBox.InnerLeftContent>
            <ui:SymbolIcon Symbol="Find" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,0,8,0" VerticalAlignment="Center" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button Classes="icon-ghost" IsVisible="{Binding HasQuery}"
                    Command="{Binding ClearSearchCommand}" ToolTip.Tip="清除搜索">
              <ui:SymbolIcon Symbol="Cancel" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Button>
          </TextBox.InnerRightContent>
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
      </Grid>

      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <RadioButton Classes="segment" Content="CurseForge" GroupName="resSource"
                       IsChecked="{Binding CurrentSourceIndex, Converter={x:Static converters:StringEqualsConverter.Instance}, ConverterParameter=0}"
                       Command="{Binding ChangeSourceCommand}" CommandParameter="0" />
          <RadioButton Classes="segment" Content="Modrinth" GroupName="resSource"
                       IsChecked="{Binding CurrentSourceIndex, Converter={x:Static converters:StringEqualsConverter.Instance}, ConverterParameter=1}"
                       Command="{Binding ChangeSourceCommand}" CommandParameter="1" />
          <RadioButton Classes="segment" Content="全部" GroupName="resSource"
                       IsChecked="{Binding CurrentSourceIndex, Converter={x:Static converters:StringEqualsConverter.Instance}, ConverterParameter=2}"
                       Command="{Binding ChangeSourceCommand}" CommandParameter="2" />
        </StackPanel>

        <ComboBox Grid.Column="1" Width="96" Height="34" FontSize="12"
                  ItemsSource="{Binding VersionFilters}"
                  SelectedItem="{Binding VersionFilter}" />

        <ComboBox Grid.Column="2" Width="96" Height="34" FontSize="12"
                  ItemsSource="{Binding AvailableSortOptions}"
                  SelectedIndex="{Binding SortFieldIndex}">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" FontSize="12" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <ComboBox Width="108" Height="34" FontSize="12"
                    ItemsSource="{Binding InstalledVersions}"
                    SelectedItem="{Binding SelectedVersionId}"
                    IsEnabled="{Binding HasInstalledVersions}"
                    PlaceholderText="目标版本" />
          <TextBlock Text="{Binding VersionHintText}" FontSize="11" Foreground="{DynamicResource DangerBrush}"
                     IsVisible="{Binding !HasInstalledVersions}" VerticalAlignment="Center"
                     MaxWidth="150" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                   Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />

        <ui:ProgressRing Grid.Column="5" Width="16" Height="16" IsIndeterminate="True" IsActive="True"
                         IsVisible="{Binding IsLoadingMore}" VerticalAlignment="Center" />
      </Grid>

      <Separator Margin="0,6,0,0" Background="{DynamicResource DividerBrush}" />
    </StackPanel>

    <!-- 顶部提示条（错误 / 超时 / 警告） -->
    <ui:InfoBar Grid.Row="2" IsOpen="{Binding IsInfoBarOpen}" Severity="{Binding InfoBarSeverity}"
                Title="{Binding InfoBarTitle}" Message="{Binding InfoBarMessage}"
                IsClosable="True" Margin="0,0,0,12" IsVisible="{Binding IsListVisible}" />

    <Grid Grid.Row="3">
      <!-- 资源详情（覆盖列表） -->
      <ContentControl Content="{Binding DetailViewModel}" IsVisible="{Binding DetailViewModel, Converter={x:Static converters:NotNullConverter.Instance}}" />

      <!-- 骨架屏 -->
      <StackPanel IsVisible="{Binding ShowSkeleton}" Margin="0">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,6">
          <Border Width="40" Height="40" CornerRadius="6" Background="{DynamicResource SurfaceHoverBrush}" Margin="0,0,10,0" />
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <Border Height="12" Width="160" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="3" />
            <Border Height="10" Width="280" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="3" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,6">
          <Border Width="40" Height="40" CornerRadius="6" Background="{DynamicResource SurfaceHoverBrush}" Margin="0,0,10,0" />
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <Border Height="12" Width="150" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="3" />
            <Border Height="10" Width="240" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="3" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,6">
          <Border Width="40" Height="40" CornerRadius="6" Background="{DynamicResource SurfaceHoverBrush}" Margin="0,0,10,0" />
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <Border Height="12" Width="180" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="3" />
            <Border Height="10" Width="200" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="3" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,0,0,6">
          <Border Width="40" Height="40" CornerRadius="6" Background="{DynamicResource SurfaceHoverBrush}" Margin="0,0,10,0" />
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <Border Height="12" Width="140" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="3" />
            <Border Height="10" Width="260" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="3" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <!-- 空状态 -->
      <StackPanel IsVisible="{Binding IsEmptyVisible}" Classes="empty-state">
        <ui:SymbolIcon Symbol="Find" FontSize="42" Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Center" />
        <TextBlock Text="未找到匹配资源" FontSize="16" FontWeight="Medium" HorizontalAlignment="Center" />
        <TextBlock Text="换个关键词或调整筛选条件试试" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
        <Button Classes="ghost" Content="清除搜索" Command="{Binding ClearSearchCommand}"
                IsVisible="{Binding HasQuery}" HorizontalAlignment="Center" Margin="0,10,0,0" />
      </StackPanel>

      <!-- 结果列表 -->
      <ListBox x:Name="ResourceListBox"
               IsVisible="{Binding IsListVisible}"
               ScrollViewer.ScrollChanged="OnResourceScrollChanged"
               Padding="0,0,12,0"
               ItemsSource="{Binding Results}"
               Background="Transparent"
               BorderThickness="0"
               Classes="results-list">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Classes="resource-row" Tapped="OnResourceRowTapped">
              <!-- 固定高度保证各行"详情"按钮垂直对齐；中间内容用 * 列自适应收缩，避免横向挤压按钮 -->
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Height="56">

                <Border Grid.RowSpan="2" Width="48" Height="48" CornerRadius="8"
                        Background="{DynamicResource SurfaceHoverBrush}" VerticalAlignment="Center">
                  <Image Source="{Binding Icon}" Width="48" Height="48" />
                </Border>

                <!-- 标题行：来源标签紧跟资源名（SizeChanged 动态限制标题宽度，保证省略且不挤压） -->
                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="6"
                            Margin="12,0,0,0" VerticalAlignment="Center"
                            SizeChanged="OnTitleRowSizeChanged">
                  <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Medium"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Border Classes="tag" Background="#F16436" IsVisible="{Binding IsCurseForge}">
                    <TextBlock Text="CurseForge" />
                  </Border>
                  <Border Classes="tag" Background="#1BD96A" IsVisible="{Binding IsModrinth}">
                    <TextBlock Text="Modrinth" />
                  </Border>
                </StackPanel>

                <!-- 元信息行：描述在 * 列内收缩省略，作者/下载量/版本保持自身宽度 -->
                <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="12,0,0,0">
                  <TextBlock Grid.Column="0" Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}"
                             TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
                    <ui:SymbolIcon Symbol="People" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
                    <ui:SymbolIcon Symbol="Download" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Downloads}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding VersionDisplay, StringFormat=v{0}}" FontSize="11"
                             Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                             Margin="12,0,0,0" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                </Grid>

                <Button Grid.Column="2" Grid.RowSpan="2" Content="详情" Classes="accent" FontSize="12" Padding="14,6"
                        VerticalAlignment="Center" Margin="8,0,0,0"
                        Command="{Binding #Root.((vm:ResourcesViewModel)DataContext).OpenDetailCommand}"
                        CommandParameter="{Binding}" Tapped="OnActionTapped" />

              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

  </Grid>
</UserControl>

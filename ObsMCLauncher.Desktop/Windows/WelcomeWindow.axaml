<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ObsMCLauncher.Desktop.ViewModels"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
        x:Class="ObsMCLauncher.Desktop.Windows.WelcomeWindow"
        x:DataType="vm:WelcomeViewModel"
        Icon="/Assets/app_icon.ico"
        Title="欢迎使用 ObsMCLauncher"
        Width="760"
        Height="560"
        CanResize="False"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- 标题栏按钮样式（与主窗口一致） -->
        <Style Selector="Button.titlebar-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.titlebar-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>

        <Style Selector="Button.titlebar-close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E81123" />
        </Style>

        <Style Selector="Button.titlebar-close:pointerover TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- 主内容区：初始不可见不可点击，添加 anim 类后淡入 -->
        <Style Selector="Border.welcome-content">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.6" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.welcome-content.anim">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
    </Window.Styles>

    <Border x:Name="WindowRoot"
            Background="{DynamicResource WindowBackgroundBrush}"
            BoxShadow="{DynamicResource WindowShadow}"
            CornerRadius="0"
            ClipToBounds="True">
        <Grid RowDefinitions="40,*">

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource TitleBarBorderBrush}"
                    BorderThickness="0,0,0,1"
                    BoxShadow="{DynamicResource ChromeShadow}">
                <Grid ColumnDefinitions="Auto,*,Auto" Height="40">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="ObsMCLauncher" FontSize="13" FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>

                    <Panel Grid.Column="1" Background="Transparent">
                        <Border Height="40" Background="Transparent" PointerPressed="TitleBar_PointerPressed" />
                    </Panel>

                    <Button Grid.Column="2"
                            Classes="titlebar-btn titlebar-close"
                            HorizontalAlignment="Right"
                            Click="CloseButton_Click">
                        <Canvas Width="14" Height="14">
                            <Line StartPoint="1,1" EndPoint="13,13" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"/>
                            <Line StartPoint="13,1" EndPoint="1,13" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"/>
                        </Canvas>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Row="1" Background="{DynamicResource BackgroundBrush}">

                <!-- 主内容区：窗口打开后加 anim 类淡入，内部 Frame 做分页导航（开场字母动画、版本号与数据迁移入口都在欢迎首页内） -->
                <Border x:Name="ContentRoot" Classes="welcome-content">
                    <ui:Frame x:Name="WelcomeFrame"
                              IsNavigationStackEnabled="False"
                              Margin="24"
                              Background="Transparent" />
                </Border>
            </Grid>
        </Grid>
    </Border>

</Window>

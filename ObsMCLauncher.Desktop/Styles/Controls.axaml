<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="using:Avalonia.Controls"
        xmlns:ui="using:FluentAvalonia.UI.Controls">

  <!-- ===== 基础按钮 ===== -->
  <Style Selector="Button">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
  </Style>

  <!-- 模板内内容面板背景过渡：悬停/按下/禁用时颜色平滑渐变，避免生硬跳变 -->
  <Style Selector="Button /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CircularEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- 通用按钮悬停/按下：仅通过背景色变化，不用 Opacity/scale 避免闪烁 -->
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
  </Style>

  <!-- ===== 主色按钮 primary =====
       前景取 OnAccentBrush 而不是 White：品牌绿上白字只有 2.54:1，
       这个键由 AppearanceApplier 按实际填充色算出（默认绿给近黑，7.67:1）。

       ⚠️ 类名只能用 primary，**不要用 accent**：FluentAvalonia 自己的
       AccentButtonStyle 就绑在 `Button.accent` 上，它会用
       AccentFillColorDefaultBrush 直接画模板底色，彻底盖掉我们设的 Background ——
       表现为"按钮颜色改不动、永远是 FA 的默认紫"。改名前它就是靠
       CustomAccentColor 恰好也是绿才看不出来。 -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- 悬停/按下统一往暗走：原先的 AccentSecondaryBrush(#34D399) 是往亮走，
       白字会从 2.54 掉到 1.92:1；压暗则两种前景都只会更清晰。 -->
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFillHoverBrush}" />
  </Style>

  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFillPressedBrush}" />
  </Style>

  <!-- ===== 次级按钮 secondary ===== -->
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter,
                   Button.secondary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <!-- ===== 危险按钮 danger =====
       填充用 DangerFillBrush(#DC2626) 而不是 DangerBrush(#EF4444)：
       后者上的白字只有 3.76:1，压一档到 4.83:1 才合规。 -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerFillBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerFillHoverBrush}" />
  </Style>

  <Style Selector="Button.danger:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerFillHoverBrush}" />
  </Style>

  <!-- ===== 幽灵/文字按钮 ghost ===== -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavItemSelectedBackgroundBrush}" />
  </Style>

  <Style Selector="Button.ghost:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavItemSelectedBackgroundBrush}" />
  </Style>

  <!-- ===== chrome-surface（标题栏/导航栏背景） ===== -->
  <Style Selector="Border.chrome-surface">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
  </Style>

  <!-- ===== DataGrid ===== -->
  <Style Selector="dg|DataGrid">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseHighBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    <Setter Property="GridLinesVisibility" Value="All" />
  </Style>

  <Style Selector="dg|DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
  </Style>

  <Style Selector="dg|DataGridCell">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseHighBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
  </Style>

  <Style Selector="dg|DataGridRow:selected dg|DataGridCell">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumBrush}" />
  </Style>

  <Style Selector="dg|DataGridRow:pointerover dg|DataGridCell">
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
  </Style>

  <!-- ===== 对话框按钮 ===== -->
  <Style Selector="Button.dialog-button">
    <Setter Property="MinWidth" Value="80"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
  </Style>

  <!-- 原先 Background 绑的是 SystemAccentColor（一个 Color），而 Background 要的是 IBrush，
       靠隐式转换才没炸；这里换成真正的画刷，前景同步走 OnAccentBrush。 -->
  <Style Selector="Button.dialog-button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
  </Style>

  <!-- ===== TextBox =====
       高度写 Height=40：实测 Height 与 MinHeight 同时存在时 MinHeight 胜出
       （多行输入框靠自己的 MinHeight=72/76 撑开），所以这里不会压扁它们。 -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="TextBox:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <Style Selector="TextBox.fluent-input">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseHighBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- ===== ComboBox ===== -->
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ComboBox:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>

  <!-- ===== CheckBox ===== -->
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <!-- ===== ToggleSwitch ===== -->
  <Style Selector="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <!-- ===== Expander ===== -->
  <Style Selector="Expander">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- ===== RadioButton ===== -->
  <Style Selector="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>

  <!-- ===== Slider =====
       未填充轨道用 BorderBrush 而不是 SurfaceElevatedBrush：
       滑块现在长在 SettingsExpander 卡片里，卡片底色就是 SurfaceElevated 一档，
       两者同色会让"剩下的那截轨道"整段消失（看起来像滑块只有一半）。 -->
  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
  </Style>

  <Style Selector="Slider /template/ Border#TrackBackground">
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Height" Value="4"/>
  </Style>

  <Style Selector="Slider /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Slider /template/ Thumb:pressed">
    <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}"/>
    <Setter Property="RenderTransform" Value="scale(1.15)"/>
  </Style>

  <Style Selector="Slider /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="RenderTransform" Value="scale(1.15)"/>
  </Style>

  <!-- ===== TabControl ===== -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- ===== 版本齿轮按钮 ===== -->
  <Style Selector="Button.version-gear">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Button.version-gear:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.version-gear:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.version-gear:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Button.version-gear:disabled">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>

  <!-- ===== 导航标签按钮 ===== -->
  <Style Selector="Button.nav-tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.nav-tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavItemSelectedBackgroundBrush}" />
  </Style>

  <Style Selector="Button.nav-tab:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavItemSelectedBackgroundBrush}" />
  </Style>

  <!-- 导航标签按钮 - 激活状态 -->
  <Style Selector="Button.nav-tab.active">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.nav-tab.active /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.nav-tab.active:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavItemSelectedBackgroundBrush}" />
  </Style>

  <!-- ===== 卡片样式 ===== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CircularEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.card:pointerover">
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadowHover}" />
  </Style>

  <!-- 可交互卡片（悬停上浮） -->
  <Style Selector="Border.card-interactive">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CircularEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.card-interactive:pointerover">
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadowHover}" />
    <Setter Property="RenderTransform" Value="translateY(-2px)" />
  </Style>

  <!-- ===== 骨架屏（Shimmer） ===== -->
  <Style Selector="Border.shimmer">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="CornerRadius" Value="6"/>
  </Style>

  <Style Selector="Border.shimmer-line">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Height" Value="12"/>
  </Style>

  <Style Selector="Border.shimmer-circle">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
    <Setter Property="CornerRadius" Value="99"/>
  </Style>

  <!-- ===== 空状态 ===== -->
  <Style Selector="StackPanel.empty-state">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Spacing" Value="8"/>
  </Style>

  <!-- ===== 分段选择按钮（Fluent Segmented 观感，无单选圆点） ===== -->
  <Style Selector="RadioButton.segment">
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <Border x:Name="SegmentRoot"
                Background="Transparent"
                CornerRadius="6"
                BorderThickness="0"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.segment:pointerover /template/ Border#SegmentRoot">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#SegmentRoot">
    <Setter Property="Background" Value="{DynamicResource NavItemSelectedBackgroundBrush}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.segment:focus-visible /template/ Border#SegmentRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ===== 空槽位按钮（主页账号位 / 版本位为空时的占位控件） =====
       它站的是 ComboBox 的位置，所以必须长得像控件：同样 42 高、输入框底色、
       1px 描边、左对齐 + 右侧箭头。做成居中灰字的 ghost 按钮会被读成
       "不可点的占位符"，和旁边真的 ComboBox 并排时像少了半个控件。 -->
  <Style Selector="Button.slot-empty">
    <Setter Property="Height" Value="42"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>

  <Style Selector="Button.slot-empty:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
  </Style>

  <Style Selector="Button.slot-empty:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
  </Style>

  <!-- ===== 标签徽章（依赖类型 / 来源 / 最新） =====
       前景不再写死 White：这批底色（#1BD96A 绿 / #F16436 橙 / #E74C3C 红 / #95A5A6 灰）
       亮度都偏高，白字只有 1.9~3.2:1；近黑在它们上面是 5.1~10.4:1。
       三种前景：
         · 中性标签（surface 底）      → TextSecondaryBrush
         · 亮品牌色底                  → 近黑，加 .tag-brand
         · 跟随用户强调色的底          → OnAccentBrush，用 .tag-accent -->
  <Style Selector="Border.tag">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.tag TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.tag-brand TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnBrandBrush}" />
  </Style>
  <Style Selector="Border.tag-accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Border.tag-accent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <!-- ===== 链接文字按钮（依赖跳转等） ===== -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ===== 紧凑图标按钮 ===== -->
  <Style Selector="Button.icon-ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.icon-ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <!-- ===== JVM 快捷参数 chip（ToggleButton 胶囊开关） ===== -->
  <Style Selector="ToggleButton.chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ToggleButton.chip:checked">
    <Setter Property="Background" Value="{DynamicResource NavItemSelectedBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavItemSelectedBackgroundBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
  </Style>
  <Style Selector="ToggleButton.chip:checked:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavItemSelectedBackgroundBrush}" />
  </Style>

  <!--
    ===== 设置页分组 =====

    原先这里有一套手写样式（settings-card / settings-row / settings-row-icon / settings-divider），
    用来在手写的 Border + Grid 上仿 ClassIsland 的卡片外观。

    设置页现已全部迁移到 FluentAvalonia 规范（ui:SettingsExpander / ui:SettingsExpanderItem），
    那些样式的最后一个使用点已移除，故一并删除——留着只会让后来者误以为还有第二种写法。
    参数行的外观现在由 FluentAvalonia 主题提供。

    栏内分组同理，**不要**用 TextBlock 之类自造标题：
    SettingsExpander.Items 里任何非 SettingsExpanderItem 的子项，FA 都会自动套一层
    SettingsExpanderItem 容器（Padding 16,10 + MinHeight 48 + 与参数行同色底），
    结果就是一个 51px 高的"假参数行"。要分组就用嵌套 ui:SettingsExpander（默认收起）。
  -->

  <!-- ===== 崩溃分析页（MoreView 崩溃标签 + CrashAnalysisPanel + GameCrashDialogContent 共用） ===== -->

  <!-- 文字徽标 chip：FA 2.4.1 的 InfoBadge 只有 IconSource/Value 放不了文字，文字徽标统一走这套 -->
  <Style Selector="Border.crash-chip">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="9,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Border.crash-chip TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- 语义色变体：底色换语义 soft 色阶，文字换语义色 -->
  <Style Selector="Border.crash-chip-danger">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
  </Style>
  <Style Selector="Border.crash-chip-danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- 图标容器（结论区 / 原因卡片 / 弹窗头部共用） -->
  <Style Selector="Border.crash-icon-box">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <!-- 原因卡片 -->
  <Style Selector="Border.crash-cause-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <!-- 分区标题（可能原因 / 可疑 Mod 等） -->
  <Style Selector="TextBlock.crash-section-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>

  <!-- 键值信息行（崩溃弹窗询问态） -->
  <Style Selector="TextBlock.crash-info-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.crash-info-value">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- 等宽文本（报告预览） -->
  <Style Selector="SelectableTextBlock.crash-code, TextBlock.crash-code">
    <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

</Styles>
